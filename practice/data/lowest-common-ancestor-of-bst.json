ll,-6841,-6226,-5088,null,-1973,-1138,null,null,317,570,2515,3186,5773,null,null,null,null,null,null,9045,-7081,null,null,-6018,-5194,-4830,-2697,null,-1278,-583,null,null,null,1438,2354,null,null,null,null,null,null,null,null,null,null,-5895,-5356,null,null,null,-3251,-2293,-1531,-1147,null,null,null,null,1651,null,null,null,-5514,null,null,null,-2674,null,-1628,-1522,null,null,null,null,null,-5444,null,null,null,null,null,-1402],-6841,7065],"out":6238},{"args":[[3041,289,9380,-494,2685,3904,9866,-4361,-95,1367,2932,null,5045,null,null,-8136,-1847,-382,null,1180,1967,2834,null,4252,7021,-8220,-4629,-4216,-1697,null,-157,1024,null,1553,2565,null,null,4098,null,6950,9134,-8826,-8181,-4948,-4595,null,-3926,null,-948,null,null,null,null,null,null,2446,null,null,4183,6445,null,8873,9173,null,-8716,null,-8152,-5873,null,null,null,null,-3728,-1320,-609,null,null,null,null,6142,null,7392,null,null,9309,null,-8318,null,null,-7585,-5485,null,-2988,null,-1141,-811,-518,5454,6432,null,7695,null,9367,null,null,null,-5969,-5585,-5227,-3185,null,null,null,null,-620,null,null,5136,null,null,null,7512,8473,null,null,-6709,null,-5843,null,null,null,null,null,null,null,null,null,null,null,8186,null,null,-6332,null,null,7700,8408],-8318,-8152],"out":-8220},{"args":[[2822,-8021,6333,-9500,2246,3168,8330,null,-8091,-4204,null,null,5666,7845,8745,-8341,null,-6494,-3349,3956,6256,6580,null,8573,null,null,null,null,-6013,null,-448,3269,4227,null,null,null,7642,null,null,null,null,-937,514,null,null,null,null,null,null,null,null,483,1775,-24],1775,514],"out":514},{"args":[[4333,-8231,8774,-9023,-7926,6748,8836,-9527,null,null,-3316,5820,null,null,null,null,null,-3728,1094,null,null,-4013,null,-1094,1400,-6081,null,-2887,149,null,null,null,-4534,null,null,null,null,null,-4417,null,-4095],-7926,4333],"out":4333}],"ref":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 利用 BST 性質：兩者都小往左、都大往右，否則分岔點就是答案\n// 時間複雜度: O(h)，空間複雜度: O(1)\nfunction lowestCommonAncestor(root, p, q) {\n    let node = root;\n    while (node) {\n        if (p.val < node.val && q.val < node.val)\n            node = node.left;\n        else if (p.val > node.val && q.val > node.val)\n            node = node.right;\n        else\n            return node;\n    }\n    return null;\n}\n","solutions":{"python":"# 迭代版（推薦，O(1) 空間）\nclass Solution:\n    def lowestCommonAncestor(self, root: 'TreeNode', p: 'TreeNode', q: 'TreeNode') -> 'TreeNode':\n        cur = root\n        while cur:\n            if p.val < cur.val and q.val < cur.val:\n                cur = cur.left       # 兩者都在左子樹\n            elif p.val > cur.val and q.val > cur.val:\n                cur = cur.right      # 兩者都在右子樹\n            else:\n                return cur           # 分岔點就是 LCA\n        return None\n\n\n# 遞迴版\nclass Solution:\n    def lowestCommonAncestor(self, root, p, q):\n        if p.val < root.val and q.val < root.val:\n            return self.lowestCommonAncestor(root.left, p, q)\n        if p.val > root.val and q.val > root.val:\n            return self.lowestCommonAncestor(root.right, p, q)\n        return root","cpp":"// 迭代版（推薦，O(1) 空間）\nclass Solution {\npublic:\n    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {\n        TreeNode* cur = root;\n        while (cur) {\n            if (p->val < cur->val && q->val < cur->val) {\n                cur = cur->left;      // 兩者都在左子樹\n            } else if (p->val > cur->val && q->val > cur->val) {\n                cur = cur->right;     // 兩者都在右子樹\n            } else {\n                return cur;           // 分岔點就是 LCA\n            }\n        }\n        return nullptr;\n    }\n};\n\n// 遞迴版\nclass Solution {\npublic:\n    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {\n        if (p->val < root->val && q->val < root->val)\n            return lowestCommonAncestor(root->left, p, q);\n        if (p->val > root->val && q->val > root->val)\n            return lowestCommonAncestor(root->right, p, q);\n        return root;\n    }\n};","java":"// 迭代版（推薦，O(1) 空間）\nclass Solution {\n    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {\n        TreeNode cur = root;\n        while (cur != null) {\n            if (p.val < cur.val && q.val < cur.val) {\n                cur = cur.left;       // 兩者都在左子樹\n            } else if (p.val > cur.val && q.val > cur.val) {\n                cur = cur.right;      // 兩者都在右子樹\n            } else {\n                return cur;           // 分岔點就是 LCA\n            }\n        }\n        return null;\n    }\n}","typescript":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 利用 BST 性質：兩者都小往左、都大往右，否則分岔點就是答案\n// 時間複雜度: O(h)，空間複雜度: O(1)\nfunction lowestCommonAncestor(root: TreeNode | null, p: TreeNode | null, q: TreeNode | null): TreeNode | null {\n    let node = root;\n    while (node) {\n        if (p!.val < node.val && q!.val < node.val) node = node.left;\n        else if (p!.val > node.val && q!.val > node.val) node = node.right;\n        else return node;\n    }\n    return null;\n}\n","c":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     struct TreeNode *left;\n *     struct TreeNode *right;\n * };\n */\n// 利用 BST 性質：兩者都小往左、都大往右，否則分岔點就是答案\n// 時間複雜度: O(h)，空間複雜度: O(1)\nstruct TreeNode* lowestCommonAncestor(struct TreeNode* root, struct TreeNode* p, struct TreeNode* q) {\n    struct TreeNode* node = root;\n    while (node) {\n        if (p->val < node->val && q->val < node->val) node = node->left;\n        else if (p->val > node->val && q->val > node->val) node = node->right;\n        else return node;\n    }\n    return NULL;\n}\n"}}