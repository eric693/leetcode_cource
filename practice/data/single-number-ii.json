1796499979,194849332,-1347558134,1960661598,1960661598,-485138986,-217072930,1203752730,2065745135,503560100,503560100,938958849,194849332,-775211295,73011963,1030373478,222841006,2065745135,-124006576,222841006,363983834,938958849,844989554,-647532572,-1958770402,194849332,-1575783615,-217072930,589854943,464947619,600803024,1203752730,-775211295,-868146729,17429985,464947619,844989554,17429985,363983834,363983834,-124006576,600803024,589854943,1960661598,-1126356160,222841006,-485138986,938958849,-868146729,-480124052,-775211295,-1958770402,17429985,844989554,503560100,1203752730,-868146729,2019695283,-1126356160,-480124052,589854943]],"out":1030373478},{"args":[[1166693055,-1038043432,-744493770,-744493770,-1383939428,-1163244517,-1383939428,2072655751,2072655751,1166693055,889543613,-1038043432,-1383939428,-744493770,-1163244517,1625085181,1625085181,2072655751,1625085181,1166693055,-1038043432,-1163244517]],"out":889543613},{"args":[[715883122,-1524495882,-1328156653,957500550,-1706643739,-475516302,-1921313954,-1369843878,1490917836,-475516302,468880551,-1648607606,-401675976,-1328156653,-148041769,1444955553,-811234991,-1112878981,-475516302,1436424146,-1369843878,-401675976,-2140812528,-1648607606,421868880,-1524495882,1444955553,-1627735832,-1706643739,-148041769,1444955553,-148041769,957500550,952348266,-2140812528,952348266,-1627735832,-1921313954,-1524495882,952348266,-1112878981,421868880,-1043433162,-2140812528,1490917836,-1112878981,-1369843878,1702631311,1490917836,-1921313954,957500550,1702631311,1436424146,-1043433162,421868880,715883122,-401675976,-1648607606,-1043433162,-1328156653,1702631311,715883122,-1627735832,-811234991,-811234991,-1706643739,1436424146]],"out":468880551},{"args":[[476282892,52526660,-473926982,52526660,-701020863,642690158,480096487,-1228663017,-30272886,-1228663017,1746491347,1984280354,813532615,890153288,1463015360,890153288,-1258531901,-1427457393,-701020863,-1228663017,1746491347,-701020863,-473926982,-305604072,-247852807,813532615,476282892,919763007,2144059799,642690158,-305604072,-1078495284,-873885557,-873885557,-1427457393,-1427457393,476282892,919763007,-247852807,890153288,-899786746,813532615,1463015360,-30272886,-30272886,-305604072,480096487,1984280354,-1258531901,-1258531901,642690158,480096487,-873885557,-1229582643,1850934472,919763007,2144059799,1850934472,-1078495284,-1229582643,-899786746,-473926982,-899786746,1984280354,-1229582643,52526660,-247852807,-1078495284,1850934472,2144059799,1746491347,1463015360,1454794259]],"out":1454794259}],"ref":"// 逐位統計：每一位 1 出現的次數 mod 3，餘下的就是只出現一次的數\n// 時間複雜度: O(32n)，空間複雜度: O(1)\nfunction singleNumber(nums) {\n    let result = 0;\n    for (let bit = 0; bit < 32; bit++) {\n        let count = 0;\n        for (const x of nums)\n            count += (x >> bit) & 1;\n        if (count % 3)\n            result |= 1 << bit;\n    }\n    return result; // 位元運算結果本身就是有號 32 位元\n}\n","solutions":{"python":"# 方法一：位元計數（好理解）\nclass Solution:\n    def singleNumber(self, nums: List[int]) -> int:\n        result = 0\n        for i in range(32):\n            bit_sum = 0\n            for num in nums:\n                # 取第 i 位（用 & 0xFFFFFFFF 處理 Python 負數）\n                bit_sum += (num >> i) & 1\n            if bit_sum % 3:\n                result |= (1 << i)\n        # 處理負數：第 31 位是符號位\n        if result >= (1 << 31):\n            result -= (1 << 32)\n        return result\n\n\n# 方法二：狀態機（O(1) 空間最優）\nclass Solution:\n    def singleNumber(self, nums: List[int]) -> int:\n        ones = twos = 0\n        for num in nums:\n            ones = (ones ^ num) & ~twos\n            twos = (twos ^ num) & ~ones\n        # Python 無限位元，需手動處理負數\n        return ones if ones < (1 << 31) else ones - (1 << 32)\n\n\n# 方法三：用 Counter（不符合 O(1) 空間，但面試可先講）\nclass Solution:\n    def singleNumber(self, nums: List[int]) -> int:\n        from collections import Counter\n        for num, cnt in Counter(nums).items():\n            if cnt == 1:\n                return num","cpp":"// 方法一：位元計數\nclass Solution {\npublic:\n    int singleNumber(vector<int>& nums) {\n        int result = 0;\n        for (int i = 0; i < 32; i++) {\n            int bitSum = 0;\n            for (int num : nums) {\n                bitSum += (num >> i) & 1;\n            }\n            if (bitSum % 3) {\n                result |= (1 << i);\n            }\n        }\n        return result;\n    }\n};\n\n// 方法二：狀態機（推薦，O(n) 時間 O(1) 空間）\nclass Solution {\npublic:\n    int singleNumber(vector<int>& nums) {\n        int ones = 0, twos = 0;\n        for (int num : nums) {\n            ones = (ones ^ num) & ~twos;\n            twos = (twos ^ num) & ~ones;\n        }\n        return ones;\n    }\n};","java":"// 方法一：位元計數\nclass Solution {\n    public int singleNumber(int[] nums) {\n        int result = 0;\n        for (int i = 0; i < 32; i++) {\n            int bitSum = 0;\n            for (int num : nums) {\n                bitSum += (num >> i) & 1;\n            }\n            if (bitSum % 3 != 0) {\n                result |= (1 << i);\n            }\n        }\n        return result;\n    }\n}\n\n// 方法二：狀態機（推薦）\nclass Solution {\n    public int singleNumber(int[] nums) {\n        int ones = 0, twos = 0;\n        for (int num : nums) {\n            ones = (ones ^ num) & ~twos;\n            twos = (twos ^ num) & ~ones;\n        }\n        return ones;\n    }\n}","typescript":"// 逐位統計：每一位 1 出現的次數 mod 3，餘下的就是只出現一次的數\n// 時間複雜度: O(32n)，空間複雜度: O(1)\nfunction singleNumber(nums: number[]): number {\n    let result = 0;\n    for (let bit = 0; bit < 32; bit++) {\n        let count = 0;\n        for (const x of nums) count += (x >> bit) & 1;\n        if (count % 3) result |= 1 << bit;\n    }\n    return result;                          // 位元運算結果本身就是有號 32 位元\n}\n","c":"// 狀態機：ones / twos 記錄每一位出現 1 次 / 2 次（出現 3 次就歸零）\n// 時間複雜度: O(n)，空間複雜度: O(1)\nint singleNumber(int* nums, int numsSize) {\n    int ones = 0, twos = 0;\n    for (int i = 0; i < numsSize; i++) {\n        ones = (ones ^ nums[i]) & ~twos;\n        twos = (twos ^ nums[i]) & ~ones;\n    }\n    return ones;\n}\n"}}