ull,null,null,99,80,null,null,3,46,-96,95,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,-27,null,null,null,null,-24,-95,-7,null,-78,-35,-94,-62,null,null,46,23,null,null,null,null,null,null,3,null,null,63]],"out":22}],"ref":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 後序遍歷：直徑 = 某節點左深度 + 右深度 的最大值\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction diameterOfBinaryTree(root) {\n    let best = 0;\n    const depth = (node) => {\n        if (!node)\n            return 0;\n        const left = depth(node.left);\n        const right = depth(node.right);\n        best = Math.max(best, left + right);\n        return 1 + Math.max(left, right);\n    };\n    depth(root);\n    return best;\n}\n","solutions":{"python":"class Solution:\n    def diameterOfBinaryTree(self, root: Optional[TreeNode]) -> int:\n        self.answer = 0\n\n        def depth(node):\n            if not node:\n                return 0\n\n            left = depth(node.left)      # 左子樹最大深度\n            right = depth(node.right)    # 右子樹最大深度\n\n            # 更新答案：經過 node 的最長路徑（可以用兩邊）\n            self.answer = max(self.answer, left + right)\n\n            # 往上回報：只能選一邊，再加上自己這條邊\n            return 1 + max(left, right)\n\n        depth(root)\n        return self.answer","cpp":"class Solution {\n    int answer = 0;\n\n    int depth(TreeNode* node) {\n        if (!node) return 0;\n\n        int left  = depth(node->left);\n        int right = depth(node->right);\n\n        // 更新答案：經過 node 的最長路徑（用兩邊）\n        answer = max(answer, left + right);\n\n        // 往上回報：只能選一邊\n        return 1 + max(left, right);\n    }\n\npublic:\n    int diameterOfBinaryTree(TreeNode* root) {\n        depth(root);\n        return answer;\n    }\n};","java":"class Solution {\n    private int answer = 0;\n\n    public int diameterOfBinaryTree(TreeNode root) {\n        depth(root);\n        return answer;\n    }\n\n    private int depth(TreeNode node) {\n        if (node == null) return 0;\n\n        int left  = depth(node.left);\n        int right = depth(node.right);\n\n        // 更新答案：經過 node 的最長路徑（用兩邊）\n        answer = Math.max(answer, left + right);\n\n        // 往上回報：只能選一邊\n        return 1 + Math.max(left, right);\n    }\n}","typescript":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 後序遍歷：直徑 = 某節點左深度 + 右深度 的最大值\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction diameterOfBinaryTree(root: TreeNode | null): number {\n    let best = 0;\n    const depth = (node: TreeNode | null): number => {\n        if (!node) return 0;\n        const left = depth(node.left);\n        const right = depth(node.right);\n        best = Math.max(best, left + right);\n        return 1 + Math.max(left, right);\n    };\n    depth(root);\n    return best;\n}\n","c":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     struct TreeNode *left;\n *     struct TreeNode *right;\n * };\n */\n// 後序遍歷：直徑 = 某節點左深度 + 右深度 的最大值\n// 時間複雜度: O(n)，空間複雜度: O(h)\nstatic int depth(struct TreeNode* node, int* best) {\n    if (!node) return 0;\n    int left = depth(node->left, best);\n    int right = depth(node->right, best);\n    if (left + right > *best) *best = left + right;\n    return 1 + (left > right ? left : right);\n}\n\nint diameterOfBinaryTree(struct TreeNode* root) {\n    int best = 0;\n    depth(root, &best);\n    return best;\n}\n"}}