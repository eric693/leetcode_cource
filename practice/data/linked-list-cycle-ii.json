階段：一個指標回到 head，同速前進\n                ptr = head\n                while ptr != slow:\n                    ptr = ptr.next\n                    slow = slow.next\n                return ptr          # 相遇處即為環的入口\n        return None                 # fast 走到底，無環\n\n\n# 方法二：HashSet（O(n) 空間，最直覺）\nclass Solution:\n    def detectCycle(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        visited = set()\n        node = head\n        while node:\n            if node in visited:\n                return node         # 第一個重複出現的節點就是入口\n            visited.add(node)\n            node = node.next\n        return None","cpp":"// 方法一：Floyd 判圈（O(1) 空間，推薦）\nclass Solution {\npublic:\n    ListNode *detectCycle(ListNode *head) {\n        ListNode *slow = head, *fast = head;\n\n        // 第一階段：找相遇點\n        while (fast && fast->next) {\n            slow = slow->next;\n            fast = fast->next->next;\n            if (slow == fast) {\n                // 第二階段：ptr 從 head 出發，同速前進\n                ListNode *ptr = head;\n                while (ptr != slow) {\n                    ptr = ptr->next;\n                    slow = slow->next;\n                }\n                return ptr;         // 環的入口\n            }\n        }\n        return nullptr;             // 無環\n    }\n};\n\n// 方法二：HashSet\nclass Solution {\npublic:\n    ListNode *detectCycle(ListNode *head) {\n        unordered_set<ListNode*> visited;\n        while (head) {\n            if (visited.count(head)) return head;\n            visited.insert(head);\n            head = head->next;\n        }\n        return nullptr;\n    }\n};","java":"// 方法一：Floyd 判圈（O(1) 空間，推薦）\npublic class Solution {\n    public ListNode detectCycle(ListNode head) {\n        ListNode slow = head, fast = head;\n\n        // 第一階段：找相遇點\n        while (fast != null && fast.next != null) {\n            slow = slow.next;\n            fast = fast.next.next;\n            if (slow == fast) {\n                // 第二階段：ptr 從 head 出發，同速前進\n                ListNode ptr = head;\n                while (ptr != slow) {\n                    ptr = ptr.next;\n                    slow = slow.next;\n                }\n                return ptr;         // 環的入口\n            }\n        }\n        return null;                // 無環\n    }\n}\n\n// 方法二：HashSet\npublic class Solution {\n    public ListNode detectCycle(ListNode head) {\n        Set<ListNode> visited = new HashSet<>();\n        while (head != null) {\n            if (!visited.add(head)) return head;\n            head = head.next;\n        }\n        return null;\n    }\n}","typescript":"/**\n * Definition for singly-linked list.\n * class ListNode {\n *     val: number\n *     next: ListNode | null\n * }\n */\n// Floyd 判圈：相遇後，一個指標回到起點，兩者同速前進的交會點就是入環點\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction detectCycle(head: ListNode | null): ListNode | null {\n    let slow = head, fast = head;\n    while (fast && fast.next) {\n        slow = slow!.next;\n        fast = fast.next.next;\n        if (slow === fast) {\n            let p = head;\n            while (p !== slow) {\n                p = p!.next;\n                slow = slow!.next;\n            }\n            return p;\n        }\n    }\n    return null;\n}\n","c":"/**\n * Definition for singly-linked list.\n * struct ListNode {\n *     int val;\n *     struct ListNode *next;\n * };\n */\n// Floyd 判圈：相遇後，一個指標回到起點，兩者同速前進的交會點就是入環點\n// 時間複雜度: O(n)，空間複雜度: O(1)\nstruct ListNode* detectCycle(struct ListNode* head) {\n    struct ListNode *slow = head, *fast = head;\n    while (fast && fast->next) {\n        slow = slow->next;\n        fast = fast->next->next;\n        if (slow == fast) {\n            struct ListNode* p = head;\n            while (p != slow) {\n                p = p->next;\n                slow = slow->next;\n            }\n            return p;\n        }\n    }\n    return NULL;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        LJ *lc_v = &lc_c->a[0]; int lc_pos = (int)lc_c->a[1].i, lc_m = lc_v->n;\n        struct ListNode **lc_nodes = (struct ListNode **)malloc(sizeof(void *) * (lc_m + 1));\n        for (int k = 0; k < lc_m; k++) { lc_nodes[k] = (struct ListNode *)malloc(sizeof(struct ListNode)); lc_nodes[k]->val = (int)lc_v->a[k].i; lc_nodes[k]->next = NULL; }\n        for (int k = 0; k + 1 < lc_m; k++) lc_nodes[k]->next = lc_nodes[k + 1];\n        if (lc_pos >= 0 && lc_m) lc_nodes[lc_m - 1]->next = lc_nodes[lc_pos];\n        lc_t0 = lc_now();\n        struct ListNode *lc_r = detectCycle(lc_m ? lc_nodes[0] : NULL);\n        lc_ms = lc_now() - lc_t0;\n        if (!lc_r) lb_ll(&lc_o, -1); else { int idx = -1; for (int k = 0; k < lc_m; k++) if (lc_nodes[k] == lc_r) idx = k;\n          if (idx < 0) lb_put(&lc_o, \"\\\"回傳的節點不在原本的串列中\\\"\"); else lb_ll(&lc_o, idx); }\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        LJ *lc_v = &lc_c->a[0]; int lc_pos = (int)lc_c->a[1].i;\n        vector<ListNode*> lc_nodes; for (int k = 0; k < lc_v->n; k++) lc_nodes.push_back(new ListNode((int)lc_v->a[k].i));\n        for (int k = 0; k + 1 < (int)lc_nodes.size(); k++) lc_nodes[k]->next = lc_nodes[k + 1];\n        if (lc_pos >= 0 && !lc_nodes.empty()) lc_nodes.back()->next = lc_nodes[lc_pos];\n        ListNode *lc_head = lc_nodes.empty() ? nullptr : lc_nodes[0];\n        lc_t0 = lc_now();\n        ListNode *lc_r = Solution().detectCycle(lc_head);\n        lc_ms = lc_now() - lc_t0;\n        if (!lc_r) lb_ll(&lc_o, -1); else { int idx = -1; for (int k = 0; k < (int)lc_nodes.size(); k++) if (lc_nodes[k] == lc_r) idx = k;\n          if (idx < 0) lb_put(&lc_o, \"\\\"回傳的節點不在原本的串列中\\\"\"); else lb_ll(&lc_o, idx); }\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}