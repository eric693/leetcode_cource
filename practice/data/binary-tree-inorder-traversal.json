ull,12,-52,null,null,80,null,-80,39,null,null,94,-4,39,-71,null,null,null,null,null,null,66,null,null,null,null,94,null,null,null,null,null,-97,null,null,null,null,null,null,38]],"out":[54,16,15,99,99,-81,35,17,-10,-10,85,-46,-66,51,12,51,-52,80,21,-59,80,-97,-44,2,-77,-25,59,-68,7,-80,35,39,23,-6,26,94,-4,38,-4,-70,39,62,-71,-82,-1,-76,-96,32,65,-62,-59,-96,66,-18,-96,-1,-94,78,87,100,25,-28,94,-82,50]},{"args":[[-42,-26,-54,-38,81,17,88,1,-82,-56,88,58,76,-13,-55,null,null,null,null,-13,-66,8,-2,null,null,78,-52,74,null,null,-30,null,null,-15,-89,null,null,47,-62,-57,66,-97,-98,null,null,null,null,null,null,null,null,null,-54,-56,45,-26,-61,90,-10,-15,null,11,-54,null,-20,null,null,null,17,null,null,62,44,null,null,71,-1,null,-82,null,null,null,1,null,null,66,90,null,null,null,null,null,null,null,null,null,null,null,null,null,null,43,86,-94]],"out":[1,-38,-82,-26,-13,-56,-15,-66,-89,81,8,88,47,-54,-20,-2,-56,-62,45,66,17,-94,43,90,86,-42,58,17,-26,-57,62,-61,44,78,90,66,71,-10,-1,76,-15,-82,-97,-52,11,-98,-54,1,-54,74,-13,88,-55,-30]},{"args":[[-48,49,89,83,-53,-93,-38,-28,19,65,-86,-27,19,4,-54,60,null,7,87,71,67,null,-92,null,null,null,null,null,-73,-30,13,-66,65,-45,-76,null,-7,-37,-1,63,-24,null,null,-68,null,42,-96,72,-40,null,null,-25,-51,52,38,-43,-49,-17,null,-61,null,null,null,24,null,40,53,82,-25,-87,-66,null,-84,-90,-64,null,99,null,null,null,null,-63,7,null,null,null,null,-26,-98,null,null,null,null,null,-60,11,null,null,null,90,-30,31,null,null,null,-61,null,null,-64,null,null,null,null,null,-86,null,null,null,-40,null,null,null,null,null,null,null,null,11,null,null,null,null,-87,null,-3,null,-1,null,-99,null,null,null,null,null,-1,null,null,null,null,null,null,null,53]],"out":[-66,60,-25,65,-51,-28,83,-63,52,7,-40,-45,38,7,-43,-76,-26,-49,-98,19,87,-17,-7,49,-61,-37,71,-1,65,24,-60,63,67,11,40,-24,53,-53,-86,-92,-48,-27,-93,19,89,4,11,90,82,-30,-68,31,-87,-1,53,-25,-73,-38,-87,42,-61,-3,-66,-30,-96,-84,-64,-1,-54,-90,72,-64,13,-40,99,-86,-99]},{"args":[[-5,42,49,-5,60,-59,50,null,2,-67,55,36,38,14,97,-71,null,null,null,-19,50,70,null,-96,30,98,-46,6,-84,-50,-86,null,null,49,-2,94,null,null,null,null,null,null,null,36,93,null,null,null,null,-26,14,null,null,-1,38,-35,-49,null,null,-74,null,null,-80,-29,-15,null,null,null,null,null,null,null,-28,null,null,null,null,null,null,49,-91,-45,null,null,53,null,null,null,16,null,null,null,null,-66,20]],"out":[-5,49,-29,-91,-66,16,20,-26,-45,-15,-50,14,-71,-86,2,42,-67,60,-19,55,-1,49,38,50,-35,-28,53,-2,-49,-5,94,70,36,-59,-96,38,30,49,98,14,-74,36,-46,93,-80,50,6,97,-84]}],"ref":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 迭代：用堆疊模擬遞迴（左 → 根 → 右）\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction inorderTraversal(root) {\n    const result = [];\n    const stack = [];\n    let cur = root;\n    while (cur || stack.length) {\n        while (cur) { // 一路往左走到底\n            stack.push(cur);\n            cur = cur.left;\n        }\n        const node = stack.pop();\n        result.push(node.val); // 訪問根\n        cur = node.right; // 轉向右子樹\n    }\n    return result;\n}\n","solutions":{"python":"# 方法一：遞迴（最簡潔）\nclass Solution:\n    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\n        result = []\n\n        def dfs(node):\n            if not node:\n                return\n            dfs(node.left)          # 左\n            result.append(node.val)  # 根\n            dfs(node.right)         # 右\n\n        dfs(root)\n        return result\n\n\n# 方法二：迭代 + 堆疊（面試常考）\nclass Solution:\n    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\n        result, stack = [], []\n        cur = root\n\n        while cur or stack:\n            # 一路向左壓入堆疊\n            while cur:\n                stack.append(cur)\n                cur = cur.left\n            # 彈出並處理，然後轉向右子樹\n            cur = stack.pop()\n            result.append(cur.val)\n            cur = cur.right\n\n        return result\n\n\n# 方法三：Morris 遍歷（O(1) 空間）\nclass Solution:\n    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\n        result = []\n        cur = root\n\n        while cur:\n            if not cur.left:\n                result.append(cur.val)      # 沒有左子樹，直接輸出\n                cur = cur.right\n            else:\n                # 找中序前驅：左子樹中最右邊的節點\n                pred = cur.left\n                while pred.right and pred.right is not cur:\n                    pred = pred.right\n\n                if not pred.right:\n                    pred.right = cur        # 建立線索\n                    cur = cur.left\n                else:\n                    pred.right = None       # 拆除線索\n                    result.append(cur.val)\n                    cur = cur.right\n\n        return result","cpp":"// 方法一：遞迴\nclass Solution {\n    void dfs(TreeNode* node, vector<int>& result) {\n        if (!node) return;\n        dfs(node->left, result);        // 左\n        result.push_back(node->val);    // 根\n        dfs(node->right, result);       // 右\n    }\npublic:\n    vector<int> inorderTraversal(TreeNode* root) {\n        vector<int> result;\n        dfs(root, result);\n        return result;\n    }\n};\n\n// 方法二：迭代 + 堆疊（推薦）\nclass Solution {\npublic:\n    vector<int> inorderTraversal(TreeNode* root) {\n        vector<int> result;\n        stack<TreeNode*> stk;\n        TreeNode* cur = root;\n\n        while (cur || !stk.empty()) {\n            while (cur) {               // 一路向左\n                stk.push(cur);\n                cur = cur->left;\n            }\n            cur = stk.top(); stk.pop();\n            result.push_back(cur->val); // 處理根\n            cur = cur->right;           // 轉向右\n        }\n        return result;\n    }\n};\n\n// 方法三：Morris 遍歷（O(1) 空間）\nclass Solution {\npublic:\n    vector<int> inorderTraversal(TreeNode* root) {\n        vector<int> result;\n        TreeNode* cur = root;\n        while (cur) {\n            if (!cur->left) {\n                result.push_back(cur->val);\n                cur = cur->right;\n            } else {\n                TreeNode* pred = cur->left;\n                while (pred->right && pred->right != cur) pred = pred->right;\n                if (!pred->right) {\n                    pred->right = cur;          // 建立線索\n                    cur = cur->left;\n                } else {\n                    pred->right = nullptr;      // 拆除線索\n                    result.push_back(cur->val);\n                    cur = cur->right;\n                }\n            }\n        }\n        return result;\n    }\n};","java":"// 方法一：遞迴\nclass Solution {\n    public List<Integer> inorderTraversal(TreeNode root) {\n        List<Integer> result = new ArrayList<>();\n        dfs(root, result);\n        return result;\n    }\n\n    private void dfs(TreeNode node, List<Integer> result) {\n        if (node == null) return;\n        dfs(node.left, result);      // 左\n        result.add(node.val);        // 根\n        dfs(node.right, result);     // 右\n    }\n}\n\n// 方法二：迭代 + 堆疊（推薦）\nclass Solution {\n    public List<Integer> inorderTraversal(TreeNode root) {\n        List<Integer> result = new ArrayList<>();\n        Deque<TreeNode> stack = new ArrayDeque<>();\n        TreeNode cur = root;\n\n        while (cur != null || !stack.isEmpty()) {\n            while (cur != null) {        // 一路向左\n                stack.push(cur);\n                cur = cur.left;\n            }\n            cur = stack.pop();\n            result.add(cur.val);         // 處理根\n            cur = cur.right;             // 轉向右\n        }\n        return result;\n    }\n}","typescript":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 迭代：用堆疊模擬遞迴（左 → 根 → 右）\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction inorderTraversal(root: TreeNode | null): number[] {\n    const result: number[] = [];\n    const stack: TreeNode[] = [];\n    let cur = root;\n\n    while (cur || stack.length) {\n        while (cur) {            // 一路往左走到底\n            stack.push(cur);\n            cur = cur.left;\n        }\n        const node = stack.pop()!;\n        result.push(node.val);   // 訪問根\n        cur = node.right;        // 轉向右子樹\n    }\n    return result;\n}\n","c":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     struct TreeNode *left;\n *     struct TreeNode *right;\n * };\n */\n// 迭代：用堆疊模擬遞迴（左 → 根 → 右）\n// 時間複雜度: O(n)，空間複雜度: O(h)\nint* inorderTraversal(struct TreeNode* root, int* returnSize) {\n    int* result = malloc(sizeof(int) * 100);       // 題目限制節點數 ≤ 100\n    struct TreeNode* stack[100];\n    int top = 0;\n    *returnSize = 0;\n    struct TreeNode* cur = root;\n\n    while (cur || top > 0) {\n        while (cur) {                              // 一路往左走到底\n            stack[top++] = cur;\n            cur = cur->left;\n        }\n        struct TreeNode* node = stack[--top];\n        result[(*returnSize)++] = node->val;       // 訪問根\n        cur = node->right;                         // 轉向右子樹\n    }\n    return result;\n}\n"}}