9,984565734,354820416,100997559,-147013004,-613654729,-540400797,416207263,751641996,538551067,487361087,-347877598,447229224,664649797,338139637,-725706267,830920733,579538934,-61052427,431301994,340425300,412136362,-160009276,598142246,-637197198,854151325,559800043,119379350,22304460,267445326,-37940234,446771934,320439199,761121283,-187700902,547012663,31606131,24293682,-845658560,-161764877,861178501,671540807,-233255671,-710701061,600405725,-329048138,116104727,559045058,-2742422,-95118863,141961987,-854982888,-390029947,-169827969,-183217299,-130805755,-70719448,887282636,842585602,599239638,168498471,906013835,532011745,768181520,-280781501,-169507761,-804641939,960116415,972495845,658880530,-450554639,-576652623,-431580613,-581687326,906298414,-205106106,736573866,-782537845,401980770,107105009,87955585,-931004324,-997665545,-370970770,68055132,33825390,-470717404,-928738485,-35878805,-193122487,-693039226,975926512,658806511,386075454,155686842,736101629,752113072,531383290,450873595,-989493123,-202998423,313406001,548168742,299817485,-407034484,260544190,-606826512,226997483,-807090898,-473774350,-438150984,228597665,66715249,539485357,653948184,122547861,-67375156,779469659,-426841866,51895722,779810131,47837209,-50298560,31973115,-512713691,-565297912,-879336140,-540759929,333239183,933204517,-415465319,-503724703,322715622,467619675,-356770010,-188576050,-142065548,-826863730,219756654,98885369,-518115991,159334139,-619658613,-311433467,148265150,33093615,544114802,-607578733,417887513],-792030997],"out":[271,520]}],"ref":"// 雜湊表：邊遍歷邊查詢補數是否已經出現過\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction twoSum(nums, target) {\n    const seen = new Map(); // 數值 → 索引\n    for (let i = 0; i < nums.length; i++) {\n        const j = seen.get(target - nums[i]);\n        if (j !== undefined)\n            return [j, i];\n        seen.set(nums[i], i);\n    }\n    return [];\n}\n","solutions":{"python":"class Solution:\n    def twoSum(self, nums: List[int], target: int) -> List[int]:\n        \"\"\"\n        使用雜湊表找出兩數之和\n        時間複雜度: O(n)\n        空間複雜度: O(n)\n        \"\"\"\n        # 建立雜湊表，鍵為數字，值為索引\n        hash_map = {}\n        \n        # 遍歷陣列\n        for i, num in enumerate(nums):\n            # 計算需要的補數\n            complement = target - num\n            \n            # 如果補數在雜湊表中，找到答案\n            if complement in hash_map:\n                return [hash_map[complement], i]\n            \n            # 將當前數字和索引存入雜湊表\n            hash_map[num] = i\n        \n        # 題目保證有解，不會執行到這裡\n        return []","cpp":"#include <vector>\n#include <unordered_map>\n\nclass Solution {\npublic:\n    /**\n     * 使用雜湊表找出兩數之和\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    std::vector<int> twoSum(std::vector<int>& nums, int target) {\n        // 建立雜湊表，鍵為數字，值為索引\n        std::unordered_map<int, int> hashMap;\n        \n        // 遍歷陣列\n        for (int i = 0; i < nums.size(); i++) {\n            // 計算補數\n            int complement = target - nums[i];\n            \n            // 如果補數在雜湊表中，找到答案\n            if (hashMap.find(complement) != hashMap.end()) {\n                return {hashMap[complement], i};\n            }\n            \n            // 將當前數字和索引存入雜湊表\n            hashMap[nums[i]] = i;\n        }\n        \n        return {};\n    }\n};","java":"import java.util.HashMap;\nimport java.util.Map;\n\nclass Solution {\n    /**\n     * 使用雜湊表找出兩數之和\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    public int[] twoSum(int[] nums, int target) {\n        // 建立雜湊表，鍵為數字，值為索引\n        Map<Integer, Integer> hashMap = new HashMap<>();\n        \n        // 遍歷陣列\n        for (int i = 0; i < nums.length; i++) {\n            // 計算補數\n            int complement = target - nums[i];\n            \n            // 如果補數在雜湊表中，找到答案\n            if (hashMap.containsKey(complement)) {\n                return new int[] {hashMap.get(complement), i};\n            }\n            \n            // 將當前數字和索引存入雜湊表\n            hashMap.put(nums[i], i);\n        }\n        \n        return new int[] {};\n    }\n}","typescript":"// 雜湊表：邊遍歷邊查詢補數是否已經出現過\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction twoSum(nums: number[], target: number): number[] {\n    const seen = new Map<number, number>();   // 數值 → 索引\n    for (let i = 0; i < nums.length; i++) {\n        const j = seen.get(target - nums[i]);\n        if (j !== undefined) return [j, i];\n        seen.set(nums[i], i);\n    }\n    return [];\n}\n","c":"// C 沒有內建雜湊表：把索引依數值排序後用雙指標\n// 時間複雜度: O(n log n)，空間複雜度: O(n)\nstatic int* g_nums;\n\nstatic int cmpIdx(const void* a, const void* b) {\n    int x = g_nums[*(const int*)a], y = g_nums[*(const int*)b];\n    return (x > y) - (x < y);\n}\n\nint* twoSum(int* nums, int numsSize, int target, int* returnSize) {\n    int* idx = malloc(sizeof(int) * numsSize);\n    for (int i = 0; i < numsSize; i++) idx[i] = i;\n    g_nums = nums;\n    qsort(idx, numsSize, sizeof(int), cmpIdx);    // 排序索引，保留原始位置\n\n    int* ans = malloc(sizeof(int) * 2);\n    *returnSize = 0;\n    int left = 0, right = numsSize - 1;\n    while (left < right) {\n        long sum = (long)nums[idx[left]] + nums[idx[right]];\n        if (sum == target) {\n            ans[0] = idx[left];\n            ans[1] = idx[right];\n            *returnSize = 2;\n            break;\n        }\n        if (sum < target) left++;\n        else right--;\n    }\n    free(idx);\n    return ans;\n}\n"}}