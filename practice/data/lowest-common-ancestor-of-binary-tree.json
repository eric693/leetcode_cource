6303509,224551642,-676896934,-758420058,-181665631,-901169532,-617008818,443661563,null,null,313501256,null,-356296431,722582364,null,null,466633521,139461333,798114012,null,null,null,null,null,null,null,340372574,null,348592400,-460137454,null,null,141298967,114414950,null,null,null,null,862273108,null,null,null,null,null,-406630704,551011973,null,null,40488135,null,-283817183,77424586,173077368,563135163,null,null,null,null,null,null,null,null,null,null,-858794020,264046007,null,null,null,null,null,null,570007045,-803159470,null,-729164418,null,329606045,null,573435793,null,null,324138550,null,null,-210438312,null,null,null,151416105,null,null,null,null,null,null,null,null,null,202198724,-604342460],-124970376,-143682463],"out":-710033086},{"args":[[525930308,-166055086,-352518007,null,109201885,-746891279,75162005,724874302,-151266130,298667321,227624728,-400892938,-893483324,null,549929125,null,-827998829,768055821,963596263,737926016,987460122,530473445,-919834613,-165288628,584012916,null,null,null,null,-680025937,484259513,null,-852182767,-411988063,679469338,536018078,-706898715,-91834311,-178482994,-699400180,-563227613,-694547962,-922996670,776491862,-554039332,null,null,696759326,-455789952,-365313556,null,-938174143,-503298072,-907230761,133102646,302415231,-130713688,571377951,256475629,464299914,-932229938,-709899792,-851690787,null,null,null,null,-532564387,-13534031,null,-491533318,668832027,695371307,null,null,null,93787173,null,null,null,null,234565287,null,-780595546,916264332,null,null,null,125189054,708259483,-585777112,null,null,null,null,null,-363712998,-793615248,56328160,775075267,-514726529,699834002,-348472051,-488788831,-602845744,null,967478997,null,null,null,null,-603801062,null,null,null,null,null,-49157005,-565391727,null,null,null,null,null,null,null,null,-548326174,null,null,null,null,null,null,null,null,552744543,null,null,-961065240,null,102310352,-662816315,24275036,null,null,null,null,null,null,null,null,-585927645,null,110935910,null,null,null,null,-218069971,774049840,589619216,311835004],530473445,-49157005],"out":-352518007}],"ref":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 後序遞迴：左右子樹各找到一個，當前節點就是 LCA\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction lowestCommonAncestor(root, p, q) {\n    if (!root || root === p || root === q)\n        return root;\n    const left = lowestCommonAncestor(root.left, p, q);\n    const right = lowestCommonAncestor(root.right, p, q);\n    if (left && right)\n        return root;\n    return left ?? right;\n}\n","solutions":{"python":"# 遞迴（推薦，簡潔優雅）\nclass Solution:\n    def lowestCommonAncestor(self, root: 'TreeNode', p: 'TreeNode', q: 'TreeNode') -> 'TreeNode':\n        # 情況 1：走到底，或命中目標\n        if not root or root is p or root is q:\n            return root\n\n        # 分別在左右子樹中尋找\n        left = self.lowestCommonAncestor(root.left, p, q)\n        right = self.lowestCommonAncestor(root.right, p, q)\n\n        # 情況 2：兩側各找到一個 → root 就是 LCA\n        if left and right:\n            return root\n\n        # 情況 3：只有一側有結果，往上傳\n        return left if left else right\n\n\n# 方法二：記錄父節點 + 集合（更直覺，也更好處理多次查詢）\nclass Solution:\n    def lowestCommonAncestor(self, root, p, q):\n        parent = {root: None}\n\n        # BFS/DFS 建立每個節點的父節點對照表\n        stack = [root]\n        while stack:\n            node = stack.pop()\n            if node.left:\n                parent[node.left] = node\n                stack.append(node.left)\n            if node.right:\n                parent[node.right] = node\n                stack.append(node.right)\n\n        # 收集 p 的所有祖先\n        ancestors = set()\n        node = p\n        while node:\n            ancestors.add(node)\n            node = parent[node]\n\n        # 從 q 往上找第一個在 p 祖先集合中的節點\n        node = q\n        while node not in ancestors:\n            node = parent[node]\n        return node","cpp":"// 遞迴（推薦）\nclass Solution {\npublic:\n    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {\n        // 情況 1：走到底，或命中目標\n        if (!root || root == p || root == q) return root;\n\n        TreeNode* left  = lowestCommonAncestor(root->left,  p, q);\n        TreeNode* right = lowestCommonAncestor(root->right, p, q);\n\n        // 情況 2：兩側各找到一個 → root 就是 LCA\n        if (left && right) return root;\n\n        // 情況 3：只有一側有結果，往上傳\n        return left ? left : right;\n    }\n};","java":"// 遞迴（推薦）\nclass Solution {\n    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {\n        // 情況 1：走到底，或命中目標\n        if (root == null || root == p || root == q) return root;\n\n        TreeNode left  = lowestCommonAncestor(root.left,  p, q);\n        TreeNode right = lowestCommonAncestor(root.right, p, q);\n\n        // 情況 2：兩側各找到一個 → root 就是 LCA\n        if (left != null && right != null) return root;\n\n        // 情況 3：只有一側有結果，往上傳\n        return (left != null) ? left : right;\n    }\n}","typescript":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// 後序遞迴：左右子樹各找到一個，當前節點就是 LCA\n// 時間複雜度: O(n)，空間複雜度: O(h)\nfunction lowestCommonAncestor(root: TreeNode | null, p: TreeNode | null, q: TreeNode | null): TreeNode | null {\n    if (!root || root === p || root === q) return root;\n    const left = lowestCommonAncestor(root.left, p, q);\n    const right = lowestCommonAncestor(root.right, p, q);\n    if (left && right) return root;\n    return left ?? right;\n}\n","c":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     struct TreeNode *left;\n *     struct TreeNode *right;\n * };\n */\n// 後序遞迴：左右子樹各找到一個，當前節點就是 LCA\n// 時間複雜度: O(n)，空間複雜度: O(h)\nstruct TreeNode* lowestCommonAncestor(struct TreeNode* root, struct TreeNode* p, struct TreeNode* q) {\n    if (!root || root == p || root == q) return root;\n    struct TreeNode* left = lowestCommonAncestor(root->left, p, q);\n    struct TreeNode* right = lowestCommonAncestor(root->right, p, q);\n    if (left && right) return root;\n    return left ? left : right;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        struct TreeNode *lc_root = lcc_tree(&lc_c->a[0]); int lc_pv = (int)lc_c->a[1].i, lc_qv = (int)lc_c->a[2].i;\n        struct TreeNode *lc_p = NULL, *lc_q = NULL; int cap = 1024, top = 0; struct TreeNode **st = (struct TreeNode **)malloc(sizeof(void *) * cap);\n        if (lc_root) st[top++] = lc_root;\n        while (top) { struct TreeNode *x = st[--top]; if (x->val == lc_pv) lc_p = x; if (x->val == lc_qv) lc_q = x;\n          if (top + 2 > cap) { cap *= 2; st = (struct TreeNode **)realloc(st, sizeof(void *) * cap); } if (x->left) st[top++] = x->left; if (x->right) st[top++] = x->right; }\n        lc_t0 = lc_now();\n        struct TreeNode *lc_r = lowestCommonAncestor(lc_root, lc_p, lc_q);\n        lc_ms = lc_now() - lc_t0;\n        if (!lc_r) lb_put(&lc_o, \"null\"); else lb_ll(&lc_o, lc_r->val);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        TreeNode *lc_root = lcx::from<TreeNode*>(&lc_c->a[0]); int lc_pv = (int)lc_c->a[1].i, lc_qv = (int)lc_c->a[2].i;\n        TreeNode *lc_p = nullptr, *lc_q = nullptr; vector<TreeNode*> st; if (lc_root) st.push_back(lc_root);\n        while (!st.empty()) { TreeNode *x = st.back(); st.pop_back(); if (x->val == lc_pv) lc_p = x; if (x->val == lc_qv) lc_q = x; if (x->left) st.push_back(x->left); if (x->right) st.push_back(x->right); }\n        lc_t0 = lc_now();\n        TreeNode *lc_r = Solution().lowestCommonAncestor(lc_root, lc_p, lc_q);\n        lc_ms = lc_now() - lc_t0;\n        if (!lc_r) lb_put(&lc_o, \"null\"); else lb_ll(&lc_o, lc_r->val);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}