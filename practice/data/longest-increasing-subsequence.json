2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499]],"out":2500}],"ref":"// 貪心 + 二分：tails[k] = 長度為 k+1 的遞增子序列的最小結尾\n// 時間複雜度: O(n log n)，空間複雜度: O(n)\nfunction lengthOfLIS(nums) {\n    const tails = [];\n    for (const x of nums) {\n        let lo = 0, hi = tails.length;\n        while (lo < hi) { // 找第一個 ≥ x 的位置\n            const mid = (lo + hi) >> 1;\n            if (tails[mid] < x)\n                lo = mid + 1;\n            else\n                hi = mid;\n        }\n        tails[lo] = x; // lo === length 時等同 push\n    }\n    return tails.length;\n}\n","solutions":{"python":"class Solution:\n    def lengthOfLIS(self, nums: List[int]) -> int:\n        \"\"\"\n        方法一：動態規劃 O(n²)\n        時間複雜度: O(n²)\n        空間複雜度: O(n)\n        \"\"\"\n        if not nums:\n            return 0\n        \n        n = len(nums)\n        # dp[i] 表示以 nums[i] 結尾的最長遞增子序列長度\n        dp = [1] * n\n        \n        for i in range(1, n):\n            for j in range(i):\n                # 如果 nums[j] < nums[i]，可以將 nums[i] 接在以 nums[j] 結尾的序列後\n                if nums[j] < nums[i]:\n                    dp[i] = max(dp[i], dp[j] + 1)\n        \n        return max(dp)\n    \n    def lengthOfLIS_binary(self, nums: List[int]) -> int:\n        \"\"\"\n        方法二：二分搜尋 + 貪心 O(n log n) ⭐ 推薦\n        時間複雜度: O(n log n)\n        空間複雜度: O(n)\n        \"\"\"\n        if not nums:\n            return 0\n        \n        # tails[i] 表示長度為 i+1 的遞增子序列的最小結尾元素\n        tails = []\n        \n        for num in nums:\n            # 如果 num 比 tails 中所有元素都大，直接添加\n            if not tails or num > tails[-1]:\n                tails.append(num)\n            else:\n                # 二分搜尋找到第一個 >= num 的位置並替換\n                left, right = 0, len(tails) - 1\n                while left < right:\n                    mid = (left + right) // 2\n                    if tails[mid] < num:\n                        left = mid + 1\n                    else:\n                        right = mid\n                tails[left] = num\n        \n        return len(tails)\n    \n    def lengthOfLIS_bisect(self, nums: List[int]) -> int:\n        \"\"\"\n        方法三：使用 Python bisect 模組（最簡潔）\n        時間複雜度: O(n log n)\n        空間複雜度: O(n)\n        \"\"\"\n        from bisect import bisect_left\n        \n        tails = []\n        for num in nums:\n            pos = bisect_left(tails, num)\n            if pos == len(tails):\n                tails.append(num)\n            else:\n                tails[pos] = num\n        \n        return len(tails)","cpp":"#include <vector>\n#include <algorithm>\n\nclass Solution {\npublic:\n    /**\n     * 方法一：動態規劃 O(n²)\n     * 時間複雜度: O(n²)\n     * 空間複雜度: O(n)\n     */\n    int lengthOfLIS(std::vector<int>& nums) {\n        if (nums.empty()) {\n            return 0;\n        }\n        \n        int n = nums.size();\n        // dp[i] 表示以 nums[i] 結尾的最長遞增子序列長度\n        std::vector<int> dp(n, 1);\n        \n        for (int i = 1; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                // 如果 nums[j] < nums[i]，可以將 nums[i] 接在以 nums[j] 結尾的序列後\n                if (nums[j] < nums[i]) {\n                    dp[i] = std::max(dp[i], dp[j] + 1);\n                }\n            }\n        }\n        \n        return *std::max_element(dp.begin(), dp.end());\n    }\n    \n    /**\n     * 方法二：二分搜尋 + 貪心 O(n log n) ⭐ 推薦\n     * 時間複雜度: O(n log n)\n     * 空間複雜度: O(n)\n     */\n    int lengthOfLIS_binary(std::vector<int>& nums) {\n        if (nums.empty()) {\n            return 0;\n        }\n        \n        // tails[i] 表示長度為 i+1 的遞增子序列的最小結尾元素\n        std::vector<int> tails;\n        \n        for (int num : nums) {\n            // 使用 lower_bound 找到第一個 >= num 的位置\n            auto it = std::lower_bound(tails.begin(), tails.end(), num);\n            \n            if (it == tails.end()) {\n                // num 比所有元素都大，添加到末尾\n                tails.push_back(num);\n            } else {\n                // 替換找到的位置\n                *it = num;\n            }\n        }\n        \n        return tails.size();\n    }\n};","java":"import java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\nclass Solution {\n    /**\n     * 方法一：動態規劃 O(n²)\n     * 時間複雜度: O(n²)\n     * 空間複雜度: O(n)\n     */\n    public int lengthOfLIS(int[] nums) {\n        if (nums == null || nums.length == 0) {\n            return 0;\n        }\n        \n        int n = nums.length;\n        // dp[i] 表示以 nums[i] 結尾的最長遞增子序列長度\n        int[] dp = new int[n];\n        Arrays.fill(dp, 1);\n        \n        for (int i = 1; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                // 如果 nums[j] < nums[i]，可以將 nums[i] 接在以 nums[j] 結尾的序列後\n                if (nums[j] < nums[i]) {\n                    dp[i] = Math.max(dp[i], dp[j] + 1);\n                }\n            }\n        }\n        \n        int maxLen = 0;\n        for (int len : dp) {\n            maxLen = Math.max(maxLen, len);\n        }\n        return maxLen;\n    }\n    \n    /**\n     * 方法二：二分搜尋 + 貪心 O(n log n) ⭐ 推薦\n     * 時間複雜度: O(n log n)\n     * 空間複雜度: O(n)\n     */\n    public int lengthOfLIS_binary(int[] nums) {\n        if (nums == null || nums.length == 0) {\n            return 0;\n        }\n        \n        // tails[i] 表示長度為 i+1 的遞增子序列的最小結尾元素\n        List<Integer> tails = new ArrayList<>();\n        \n        for (int num : nums) {\n            // 二分搜尋找到第一個 >= num 的位置\n            int pos = binarySearch(tails, num);\n            \n            if (pos == tails.size()) {\n                // num 比所有元素都大，添加到末尾\n                tails.add(num);\n            } else {\n                // 替換找到的位置\n                tails.set(pos, num);\n            }\n        }\n        \n        return tails.size();\n    }\n    \n    // 二分搜尋：找到第一個 >= target 的位置\n    private int binarySearch(List<Integer> tails, int target) {\n        int left = 0, right = tails.size();\n        \n        while (left < right) {\n            int mid = left + (right - left) / 2;\n            if (tails.get(mid) < target) {\n                left = mid + 1;\n            } else {\n                right = mid;\n            }\n        }\n        \n        return left;\n    }\n}","typescript":"// 貪心 + 二分：tails[k] = 長度為 k+1 的遞增子序列的最小結尾\n// 時間複雜度: O(n log n)，空間複雜度: O(n)\nfunction lengthOfLIS(nums: number[]): number {\n    const tails: number[] = [];\n    for (const x of nums) {\n        let lo = 0, hi = tails.length;\n        while (lo < hi) {                     // 找第一個 ≥ x 的位置\n            const mid = (lo + hi) >> 1;\n            if (tails[mid] < x) lo = mid + 1;\n            else hi = mid;\n        }\n        tails[lo] = x;                        // lo === length 時等同 push\n    }\n    return tails.length;\n}\n","c":"// 貪心 + 二分：tails[k] = 長度為 k+1 的遞增子序列的最小結尾\n// 時間複雜度: O(n log n)，空間複雜度: O(n)\nint lengthOfLIS(int* nums, int numsSize) {\n    int* tails = malloc(sizeof(int) * numsSize);\n    int len = 0;\n    for (int i = 0; i < numsSize; i++) {\n        int lo = 0, hi = len;\n        while (lo < hi) {                     // 找第一個 ≥ nums[i] 的位置\n            int mid = lo + (hi - lo) / 2;\n            if (tails[mid] < nums[i]) lo = mid + 1;\n            else hi = mid;\n        }\n        tails[lo] = nums[i];\n        if (lo == len) len++;\n    }\n    free(tails);\n    return len;\n}\n"}}