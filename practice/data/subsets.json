10],[1,-9,10,-3],[1,-9,-3],[1,10],[1,10,-3],[1,-3],[6],[6,2],[6,2,-2],[6,2,-2,-9],[6,2,-2,-9,10],[6,2,-2,-9,10,-3],[6,2,-2,-9,-3],[6,2,-2,10],[6,2,-2,10,-3],[6,2,-2,-3],[6,2,-9],[6,2,-9,10],[6,2,-9,10,-3],[6,2,-9,-3],[6,2,10],[6,2,10,-3],[6,2,-3],[6,-2],[6,-2,-9],[6,-2,-9,10],[6,-2,-9,10,-3],[6,-2,-9,-3],[6,-2,10],[6,-2,10,-3],[6,-2,-3],[6,-9],[6,-9,10],[6,-9,10,-3],[6,-9,-3],[6,10],[6,10,-3],[6,-3],[2],[2,-2],[2,-2,-9],[2,-2,-9,10],[2,-2,-9,10,-3],[2,-2,-9,-3],[2,-2,10],[2,-2,10,-3],[2,-2,-3],[2,-9],[2,-9,10],[2,-9,10,-3],[2,-9,-3],[2,10],[2,10,-3],[2,-3],[-2],[-2,-9],[-2,-9,10],[-2,-9,10,-3],[-2,-9,-3],[-2,10],[-2,10,-3],[-2,-3],[-9],[-9,10],[-9,10,-3],[-9,-3],[10],[10,-3],[-3]]}],"ref":"// 回溯：每走到一個節點就記錄一次目前路徑\n// 時間複雜度: O(n · 2^n)，空間複雜度: O(n)\nfunction subsets(nums) {\n    const result = [];\n    const path = [];\n    const backtrack = (start) => {\n        result.push([...path]);\n        for (let i = start; i < nums.length; i++) {\n            path.push(nums[i]);\n            backtrack(i + 1);\n            path.pop();\n        }\n    };\n    backtrack(0);\n    return result;\n}\n","solutions":{"python":"# 方法一：回溯（推薦，可擴充到 #90 等變形）\nclass Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        result = []\n        path = []\n\n        def backtrack(start):\n            result.append(path[:])       # 每個節點都是答案！\n\n            for i in range(start, len(nums)):\n                path.append(nums[i])     # 做選擇\n                backtrack(i + 1)         # 下一層只能選 i 之後的\n                path.pop()               # 撤銷選擇\n\n        backtrack(0)\n        return result\n\n\n# 方法二：位元遮罩\nclass Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        n = len(nums)\n        result = []\n        for mask in range(1 << n):       # 0 ~ 2^n - 1\n            subset = [nums[i] for i in range(n) if mask & (1 << i)]\n            result.append(subset)\n        return result\n\n\n# 方法三：迭代擴展\nclass Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        result = [[]]\n        for num in nums:\n            # 把現有每個子集複製一份並加上 num\n            result += [subset + [num] for subset in result]\n        return result","cpp":"// 方法一：回溯（推薦）\nclass Solution {\n    vector<vector<int>> result;\n    vector<int> path;\n\n    void backtrack(vector<int>& nums, int start) {\n        result.push_back(path);          // 每個節點都是答案\n\n        for (int i = start; i < nums.size(); i++) {\n            path.push_back(nums[i]);     // 做選擇\n            backtrack(nums, i + 1);      // 只能選 i 之後的\n            path.pop_back();             // 撤銷選擇\n        }\n    }\n\npublic:\n    vector<vector<int>> subsets(vector<int>& nums) {\n        backtrack(nums, 0);\n        return result;\n    }\n};\n\n// 方法二：位元遮罩（無遞迴）\nclass Solution {\npublic:\n    vector<vector<int>> subsets(vector<int>& nums) {\n        int n = nums.size();\n        vector<vector<int>> result;\n        for (int mask = 0; mask < (1 << n); mask++) {\n            vector<int> subset;\n            for (int i = 0; i < n; i++) {\n                if (mask & (1 << i)) subset.push_back(nums[i]);\n            }\n            result.push_back(subset);\n        }\n        return result;\n    }\n};","java":"// 方法一：回溯（推薦）\nclass Solution {\n    private List<List<Integer>> result = new ArrayList<>();\n    private List<Integer> path = new ArrayList<>();\n\n    public List<List<Integer>> subsets(int[] nums) {\n        backtrack(nums, 0);\n        return result;\n    }\n\n    private void backtrack(int[] nums, int start) {\n        result.add(new ArrayList<>(path));    // 每個節點都是答案\n\n        for (int i = start; i < nums.length; i++) {\n            path.add(nums[i]);                // 做選擇\n            backtrack(nums, i + 1);           // 只能選 i 之後的\n            path.remove(path.size() - 1);     // 撤銷選擇\n        }\n    }\n}\n\n// 方法三：迭代擴展\nclass Solution {\n    public List<List<Integer>> subsets(int[] nums) {\n        List<List<Integer>> result = new ArrayList<>();\n        result.add(new ArrayList<>());\n        for (int num : nums) {\n            int size = result.size();\n            for (int i = 0; i < size; i++) {\n                List<Integer> newSubset = new ArrayList<>(result.get(i));\n                newSubset.add(num);\n                result.add(newSubset);\n            }\n        }\n        return result;\n    }\n}","typescript":"// 回溯：每走到一個節點就記錄一次目前路徑\n// 時間複雜度: O(n · 2^n)，空間複雜度: O(n)\nfunction subsets(nums: number[]): number[][] {\n    const result: number[][] = [];\n    const path: number[] = [];\n    const backtrack = (start: number): void => {\n        result.push([...path]);\n        for (let i = start; i < nums.length; i++) {\n            path.push(nums[i]);\n            backtrack(i + 1);\n            path.pop();\n        }\n    };\n    backtrack(0);\n    return result;\n}\n","c":"// 位元列舉：mask 的第 i 位為 1 代表選 nums[i]（n ≤ 10）\n// 時間複雜度: O(n · 2^n)，空間複雜度: O(1)（不含輸出）\nint** subsets(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {\n    int total = 1 << numsSize;\n    int** result = malloc(sizeof(int*) * total);\n    *returnColumnSizes = malloc(sizeof(int) * total);\n\n    for (int mask = 0; mask < total; mask++) {\n        int* subset = malloc(sizeof(int) * (numsSize ? numsSize : 1));\n        int len = 0;\n        for (int i = 0; i < numsSize; i++) {\n            if (mask & (1 << i)) subset[len++] = nums[i];\n        }\n        result[mask] = subset;\n        (*returnColumnSizes)[mask] = len;\n    }\n    *returnSize = total;\n    return result;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        int lc_rs = 0;\n        int *lc_rcs = NULL;\n        lc_t0 = lc_now();\n        int** lc_r = subsets(a0, a0n, &lc_rs, &lc_rcs);\n        lc_ms = lc_now() - lc_t0;\n        lbc_igrid(&lc_o, lc_r, lc_rs, lc_rcs);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->subsets(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}