0,219],[7760,600],[3442,481],[1804,653],[8494,578],[1560,933],[-9728,495],[8751,320],[3381,773],[-3165,579],[3066,null],[-3561,576],[2726,509],[7906,71],[-2612,421],[6972,981],[-5027,828],[-2606,811],[8874,310],[-4988,472],[-7252,418],[9803,3],[4869,416],[8926,498],[-5792,766],[6656,231],[4310,808],[-9370,null],[31,266],[-5231,67],[3287,910],[-6696,596],[9272,268],[-597,76],[9357,512],[5876,186],[7995,438],[3099,99],[-6561,778],[7820,954],[-1467,826],[-268,550],[9437,237],[9360,540],[-588,700],[4317,404],[-9289,717],[8946,236],[-596,193],[-3410,null],[3575,55],[8593,574],[-4298,558],[-3214,914],[5740,83],[1846,null],[4409,765],[9954,null],[9573,98],[-9319,39],[-6812,936],[8521,437],[-7917,671],[1131,null],[3467,595],[6300,529],[7402,715],[-5855,958],[5259,288],[8463,669],[-4707,181],[8246,395],[-7028,358],[5737,696],[9927,279],[-8540,826],[-1529,405],[2407,871],[-759,515],[9261,665],[-3232,null],[-5400,12],[-7426,429],[-9168,567],[-2809,387],[-5837,841],[-7929,239],[1801,286],[-7529,160],[-9069,465],[7622,914],[-2168,358],[-62,865],[8592,null],[-8222,34],[-2786,406],[-9052,null],[2701,923],[2450,37],[1494,549],[5140,652],[-9214,254],[-3394,806],[-8696,566],[300,243],[-7754,297],[8226,453],[-339,835],[1478,495],[-8752,null],[-692,835],[-3694,null],[-7702,982],[7420,null],[-8523,557],[-3441,890],[7353,396],[2675,286],[-8463,343],[7853,972],[6358,null],[-8443,988],[-9248,855],[9273,313],[352,993],[3673,658],[6955,891],[-9708,744],[-7366,null],[9116,694],[-5137,399],[-1633,446],[1081,null],[-9268,174],[8978,null],[-4390,470],[-107,null],[-2120,575],[-6998,985],[2830,973],[-2518,74],[-8713,35],[-9150,null],[-1382,548],[738,326],[-5323,333],[649,223],[-6300,192],[-9582,932],[-8426,96],[68,467],[9902,578],[-5562,750],[4086,null],[126,777],[3943,272],[-8933,931],[9786,null],[1969,621],[-6408,161],[8254,876],[1317,997],[-6254,943],[-4941,695],[-3904,46],[-3934,860],[-5834,144],[7948,702],[-2297,528],[9988,238],[8074,336],[-8376,267],[1979,221],[-9743,635],[-7094,122],[-3185,377],[-2013,744],[-2316,575],[949,569],[-420,901],[-2413,349],[5465,299],[-8111,419],[-9327,859],[8487,728],[1582,349],[-6993,null],[1036,380],[3731,590],[5517,620],[-5311,793],[-6179,883],[-8221,971]]}],"ref":"/**\n * Definition for _Node.\n * class _Node {\n *     val: number\n *     next: _Node | null\n *     random: _Node | null\n * }\n */\n// 雜湊表：第一輪建立所有複製節點，第二輪接上 next 與 random\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction copyRandomList(head) {\n    const map = new Map();\n    for (let cur = head; cur; cur = cur.next) {\n        map.set(cur, new _Node(cur.val));\n    }\n    for (let cur = head; cur; cur = cur.next) {\n        const copy = map.get(cur);\n        copy.next = cur.next ? map.get(cur.next) : null;\n        copy.random = cur.random ? map.get(cur.random) : null;\n    }\n    return head ? map.get(head) : null;\n}\n","solutions":{"python":"# Definition for a Node.\n# class Node:\n#     def __init__(self, x: int, next: 'Node' = None, random: 'Node' = None):\n#         self.val = int(x)\n#         self.next = next\n#         self.random = random\n\n# 方法一：HashMap（推薦，好懂好寫）\nclass Solution:\n    def copyRandomList(self, head: 'Optional[Node]') -> 'Optional[Node]':\n        if not head:\n            return None\n\n        # 第一趟：建立 原節點 -> 新節點 的對應\n        old_to_new = {}\n        cur = head\n        while cur:\n            old_to_new[cur] = Node(cur.val)\n            cur = cur.next\n\n        # 第二趟：接上 next 和 random\n        cur = head\n        while cur:\n            old_to_new[cur].next = old_to_new.get(cur.next)\n            old_to_new[cur].random = old_to_new.get(cur.random)\n            cur = cur.next\n\n        return old_to_new[head]\n\n\n# 方法二：節點交錯編織（O(1) 額外空間）\nclass Solution:\n    def copyRandomList(self, head: 'Optional[Node]') -> 'Optional[Node]':\n        if not head:\n            return None\n\n        # 步驟 1：A → A' → B → B' → ...\n        cur = head\n        while cur:\n            copy = Node(cur.val, cur.next)\n            cur.next = copy\n            cur = copy.next\n\n        # 步驟 2：設定新節點的 random\n        cur = head\n        while cur:\n            if cur.random:\n                cur.next.random = cur.random.next\n            cur = cur.next.next\n\n        # 步驟 3：拆分兩條串列，還原原串列\n        new_head = head.next\n        cur = head\n        while cur:\n            copy = cur.next\n            cur.next = copy.next\n            copy.next = copy.next.next if copy.next else None\n            cur = cur.next\n        return new_head","cpp":"// 方法一：HashMap（推薦）\nclass Solution {\npublic:\n    Node* copyRandomList(Node* head) {\n        if (!head) return nullptr;\n        unordered_map<Node*, Node*> oldToNew;\n\n        // 第一趟：只複製值\n        for (Node* cur = head; cur; cur = cur->next) {\n            oldToNew[cur] = new Node(cur->val);\n        }\n\n        // 第二趟：接 next 和 random\n        for (Node* cur = head; cur; cur = cur->next) {\n            oldToNew[cur]->next   = oldToNew[cur->next];    // 不存在時為 nullptr\n            oldToNew[cur]->random = oldToNew[cur->random];\n        }\n        return oldToNew[head];\n    }\n};\n\n// 方法二：節點交錯編織（O(1) 額外空間）\nclass Solution {\npublic:\n    Node* copyRandomList(Node* head) {\n        if (!head) return nullptr;\n\n        // 步驟 1：A → A' → B → B'\n        for (Node* cur = head; cur; ) {\n            Node* copy = new Node(cur->val);\n            copy->next = cur->next;\n            cur->next = copy;\n            cur = copy->next;\n        }\n\n        // 步驟 2：設定 random\n        for (Node* cur = head; cur; cur = cur->next->next) {\n            if (cur->random) cur->next->random = cur->random->next;\n        }\n\n        // 步驟 3：拆分\n        Node* newHead = head->next;\n        for (Node* cur = head; cur; ) {\n            Node* copy = cur->next;\n            cur->next = copy->next;\n            copy->next = cur->next ? cur->next->next : nullptr;\n            cur = cur->next;\n        }\n        return newHead;\n    }\n};","java":"// 方法一：HashMap（推薦）\nclass Solution {\n    public Node copyRandomList(Node head) {\n        if (head == null) return null;\n        Map<Node, Node> oldToNew = new HashMap<>();\n\n        // 第一趟：只複製值\n        for (Node cur = head; cur != null; cur = cur.next) {\n            oldToNew.put(cur, new Node(cur.val));\n        }\n\n        // 第二趟：接 next 和 random\n        for (Node cur = head; cur != null; cur = cur.next) {\n            oldToNew.get(cur).next   = oldToNew.get(cur.next);\n            oldToNew.get(cur).random = oldToNew.get(cur.random);\n        }\n        return oldToNew.get(head);\n    }\n}\n\n// 方法二：節點交錯編織\nclass Solution {\n    public Node copyRandomList(Node head) {\n        if (head == null) return null;\n\n        // 步驟 1：交錯插入\n        for (Node cur = head; cur != null; ) {\n            Node copy = new Node(cur.val);\n            copy.next = cur.next;\n            cur.next = copy;\n            cur = copy.next;\n        }\n\n        // 步驟 2：設定 random\n        for (Node cur = head; cur != null; cur = cur.next.next) {\n            if (cur.random != null) cur.next.random = cur.random.next;\n        }\n\n        // 步驟 3：拆分\n        Node newHead = head.next;\n        for (Node cur = head; cur != null; ) {\n            Node copy = cur.next;\n            cur.next = copy.next;\n            copy.next = (cur.next != null) ? cur.next.next : null;\n            cur = cur.next;\n        }\n        return newHead;\n    }\n}","typescript":"/**\n * Definition for _Node.\n * class _Node {\n *     val: number\n *     next: _Node | null\n *     random: _Node | null\n * }\n */\n// 雜湊表：第一輪建立所有複製節點，第二輪接上 next 與 random\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction copyRandomList(head: _Node | null): _Node | null {\n    const map = new Map<_Node, _Node>();\n    for (let cur = head; cur; cur = cur.next) {\n        map.set(cur, new _Node(cur.val));\n    }\n    for (let cur = head; cur; cur = cur.next) {\n        const copy = map.get(cur)!;\n        copy.next = cur.next ? map.get(cur.next)! : null;\n        copy.random = cur.random ? map.get(cur.random)! : null;\n    }\n    return head ? map.get(head)! : null;\n}\n","c":"/**\n * Definition for a Node.\n * struct Node {\n *     int val;\n *     struct Node *next;\n *     struct Node *random;\n * };\n */\n// 交錯節點法：A → A' → B → B'，不需要雜湊表\n// 時間複雜度: O(n)，空間複雜度: O(1)（不含輸出）\nstruct Node* copyRandomList(struct Node* head) {\n    if (!head) return NULL;\n\n    // 1. 在每個節點後面插入它的複製節點\n    for (struct Node* cur = head; cur; cur = cur->next->next) {\n        struct Node* copy = malloc(sizeof(struct Node));\n        copy->val = cur->val;\n        copy->next = cur->next;\n        copy->random = NULL;\n        cur->next = copy;\n    }\n    // 2. 複製節點的 random = 原節點 random 的下一個\n    for (struct Node* cur = head; cur; cur = cur->next->next) {\n        if (cur->random) cur->next->random = cur->random->next;\n    }\n    // 3. 拆開兩條鏈結串列，還原原串列\n    struct Node* newHead = head->next;\n    for (struct Node* cur = head; cur; cur = cur->next) {\n        struct Node* copy = cur->next;\n        cur->next = copy->next;\n        copy->next = copy->next ? copy->next->next : NULL;\n    }\n    return newHead;\n}\n"}}