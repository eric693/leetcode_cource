n        }\n        return longest;\n    }\n};","java":"class Solution {\n    public int longestValidParentheses(String s) {\n        Deque<Integer> stack = new ArrayDeque<>();\n        stack.push(-1);\n        int longest = 0;\n\n        for (int i = 0; i < s.length(); i++) {\n            if (s.charAt(i) == '(') {\n                stack.push(i);\n            } else {\n                stack.pop();\n                if (stack.isEmpty()) {\n                    stack.push(i);\n                } else {\n                    longest = Math.max(longest, i - stack.peek());\n                }\n            }\n        }\n        return longest;\n    }\n}","typescript":"// 堆疊存索引，棧底永遠放「最後一個未匹配的右括號位置」\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction longestValidParentheses(s: string): number {\n    const stack: number[] = [-1];\n    let best = 0;\n    for (let i = 0; i < s.length; i++) {\n        if (s[i] === '(') {\n            stack.push(i);\n        } else {\n            stack.pop();\n            if (stack.length === 0) stack.push(i);       // 新的分界點\n            else best = Math.max(best, i - stack[stack.length - 1]);\n        }\n    }\n    return best;\n}\n","c":"// 堆疊存索引，棧底永遠放「最後一個未匹配的右括號位置」\n// 時間複雜度: O(n)，空間複雜度: O(n)\nint longestValidParentheses(char* s) {\n    int n = strlen(s);\n    int* stack = malloc(sizeof(int) * (n + 1));\n    int top = 0, best = 0;\n    stack[top++] = -1;\n    for (int i = 0; i < n; i++) {\n        if (s[i] == '(') {\n            stack[top++] = i;\n        } else {\n            top--;\n            if (top == 0) stack[top++] = i;              // 新的分界點\n            else if (i - stack[top - 1] > best) best = i - stack[top - 1];\n        }\n    }\n    free(stack);\n    return best;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        char *a0 = lcc_str(&lc_c->a[0]);\n        lc_t0 = lc_now();\n        int lc_r = longestValidParentheses(a0);\n        lc_ms = lc_now() - lc_t0;\n        lb_ll(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        string a0 = lcx::from<string>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->longestValidParentheses(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}