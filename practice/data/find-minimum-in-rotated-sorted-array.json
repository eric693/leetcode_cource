,-3165,-3123,-3094,-3056,-2913,-2904,-2834,-2831,-2710,-2690,-2492,-2324,-2294,-2261,-2217,-2207,-2178,-2175,-2064,-2037,-1871,-1658,-1654,-1643,-1607,-1587,-1417,-1298,-1271,-1270,-1234,-1194,-1179,-1139,-1121,-1092,-1034,-1023,-1017,-949,-936,-886,-853,-831,-780,-741,-687,-667,-535,-492,-407,-75,-19,-14,30,76,114,145,195,240,423,437,459,571,638,697,749,758,809,886,904,940,1038,1086,1182,1197,1241,1288,1310,1406,1448,1450,1475,1476,1538,1899,1984,2095,2122,2155,2192,2244,2255,2263,2271,2311,2414,2505,2518,2631,2646,2665,2675,2677,2887,2914,2974,2985,3033,3098,3168,3247,3252,3294,3390,3459,3504,3516,3562,3676,3677,3706,3710,3786,3853,3940,3982,4011,4103,4153,4180,4198,4252,4350,4353,4369,4380,4403,4514,4515,4648,4677,4706,4739,4741,4750,4772,4780,4826,4831,4886,4900,4919]],"out":-4953},{"args":[[2065,2148,2194,2260,2351,2669,2687,2701,2766,2784,3140,3598,3605,4062,4066,4116,4229,4285,4445,4564,4707,4731,-4728,-4426,-4401,-4387,-4383,-4310,-4256,-4196,-4169,-4002,-3974,-3784,-3758,-3616,-3549,-3327,-3195,-3060,-3058,-3003,-2992,-2915,-2534,-2533,-2446,-2268,-2255,-1999,-1975,-1885,-1867,-1523,-1511,-1397,-1323,-1189,-1079,-1033,-811,-290,-241,-233,-103,-45,4,352,601,745,868,879,1243,1323,1474,1604,1638,1678,1735,1797,1890,1917,1992,2011]],"out":-4728},{"args":[[-4799,-4196,-3882,-3568,-3447,-2034,-1904,-959,-713,-448,773,2424,3762,-4934]],"out":-4934},{"args":[[3558,4176,4487,4835,4885,-4883,-4864,-4611,-4512,-3985,-3907,-3791,-3736,-3573,-3523,-3476,-3451,-2677,-2626,-2411,-2367,-2019,-1858,-1589,-1461,-1377,-1119,-1072,-1053,-983,-919,-591,-553,-207,14,41,146,528,686,1231,1290,1492,1851,1905,2156,2192,2337,2409,2450,2790,3349,3408,3412,3520]],"out":-4883}],"ref":"// 二分：與右端比較，判斷最小值在左半還是右半\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nfunction findMin(nums) {\n    let left = 0, right = nums.length - 1;\n    while (left < right) {\n        const mid = (left + right) >> 1;\n        if (nums[mid] > nums[right])\n            left = mid + 1; // 最小值在右半\n        else\n            right = mid; // mid 可能就是最小值\n    }\n    return nums[left];\n}\n","solutions":{"python":"# 二分搜尋（與右端點比較）\nclass Solution:\n    def findMin(self, nums: List[int]) -> int:\n        left, right = 0, len(nums) - 1\n\n        while left < right:              # 注意：不是 <=\n            mid = left + (right - left) // 2\n            if nums[mid] > nums[right]:\n                left = mid + 1           # 最小值在 mid 右側\n            else:\n                right = mid              # 最小值可能就是 mid\n        return nums[left]                # left == right 時即答案\n\n\n# 延伸 #154：允許重複元素\nclass Solution:\n    def findMin(self, nums: List[int]) -> int:\n        left, right = 0, len(nums) - 1\n        while left < right:\n            mid = left + (right - left) // 2\n            if nums[mid] > nums[right]:\n                left = mid + 1\n            elif nums[mid] < nums[right]:\n                right = mid\n            else:\n                right -= 1               # 相等時無法判斷，保守縮小\n        return nums[left]","cpp":"// 二分搜尋（與右端點比較）\nclass Solution {\npublic:\n    int findMin(vector<int>& nums) {\n        int left = 0, right = nums.size() - 1;\n\n        while (left < right) {                  // 注意：不是 <=\n            int mid = left + (right - left) / 2;\n            if (nums[mid] > nums[right]) {\n                left = mid + 1;                 // 最小值在右側\n            } else {\n                right = mid;                    // 最小值可能是 mid\n            }\n        }\n        return nums[left];\n    }\n};\n\n// 延伸 #154：允許重複元素（最壞退化為 O(n)）\nclass Solution {\npublic:\n    int findMin(vector<int>& nums) {\n        int left = 0, right = nums.size() - 1;\n        while (left < right) {\n            int mid = left + (right - left) / 2;\n            if (nums[mid] > nums[right])      left = mid + 1;\n            else if (nums[mid] < nums[right]) right = mid;\n            else                              right--;   // 相等時保守縮小\n        }\n        return nums[left];\n    }\n};","java":"// 二分搜尋（與右端點比較）\nclass Solution {\n    public int findMin(int[] nums) {\n        int left = 0, right = nums.length - 1;\n\n        while (left < right) {                  // 注意：不是 <=\n            int mid = left + (right - left) / 2;\n            if (nums[mid] > nums[right]) {\n                left = mid + 1;                 // 最小值在右側\n            } else {\n                right = mid;                    // 最小值可能是 mid\n            }\n        }\n        return nums[left];\n    }\n}","typescript":"// 二分：與右端比較，判斷最小值在左半還是右半\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nfunction findMin(nums: number[]): number {\n    let left = 0, right = nums.length - 1;\n    while (left < right) {\n        const mid = (left + right) >> 1;\n        if (nums[mid] > nums[right]) left = mid + 1;   // 最小值在右半\n        else right = mid;                               // mid 可能就是最小值\n    }\n    return nums[left];\n}\n","c":"// 二分：與右端比較，判斷最小值在左半還是右半\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nint findMin(int* nums, int numsSize) {\n    int left = 0, right = numsSize - 1;\n    while (left < right) {\n        int mid = left + (right - left) / 2;\n        if (nums[mid] > nums[right]) left = mid + 1;   // 最小值在右半\n        else right = mid;                               // mid 可能就是最小值\n    }\n    return nums[left];\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        lc_t0 = lc_now();\n        int lc_r = findMin(a0, a0n);\n        lc_ms = lc_now() - lc_t0;\n        lb_ll(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->findMin(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}