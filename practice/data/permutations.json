3,4,5,7],[-6,-3,3,4,7,5],[-6,-3,3,7,5,4],[-6,-3,3,7,4,5],[-6,3,5,4,7,-3],[-6,3,5,4,-3,7],[-6,3,5,7,4,-3],[-6,3,5,7,-3,4],[-6,3,5,-3,4,7],[-6,3,5,-3,7,4],[-6,3,4,5,7,-3],[-6,3,4,5,-3,7],[-6,3,4,7,5,-3],[-6,3,4,7,-3,5],[-6,3,4,-3,5,7],[-6,3,4,-3,7,5],[-6,3,7,5,4,-3],[-6,3,7,5,-3,4],[-6,3,7,4,5,-3],[-6,3,7,4,-3,5],[-6,3,7,-3,5,4],[-6,3,7,-3,4,5],[-6,3,-3,5,4,7],[-6,3,-3,5,7,4],[-6,3,-3,4,5,7],[-6,3,-3,4,7,5],[-6,3,-3,7,5,4],[-6,3,-3,7,4,5]]},{"args":[[-3,-5,-7]],"out":[[-3,-5,-7],[-3,-7,-5],[-5,-3,-7],[-5,-7,-3],[-7,-3,-5],[-7,-5,-3]]}],"ref":"// 回溯 + used 陣列標記已選過的元素\n// 時間複雜度: O(n · n!)，空間複雜度: O(n)\nfunction permute(nums) {\n    const result = [];\n    const path = [];\n    const used = new Array(nums.length).fill(false);\n    const backtrack = () => {\n        if (path.length === nums.length) {\n            result.push([...path]);\n            return;\n        }\n        for (let i = 0; i < nums.length; i++) {\n            if (used[i])\n                continue;\n            used[i] = true;\n            path.push(nums[i]);\n            backtrack();\n            path.pop();\n            used[i] = false;\n        }\n    };\n    backtrack();\n    return result;\n}\n","solutions":{"python":"# 方法 A：used 陣列（推薦）\nclass Solution:\n    def permute(self, nums: List[int]) -> List[List[int]]:\n        result = []\n        path = []\n        used = [False] * len(nums)\n\n        def backtrack():\n            # 終止條件：路徑長度等於陣列長度\n            if len(path) == len(nums):\n                result.append(path[:])       # 注意：要複製一份！\n                return\n\n            for i in range(len(nums)):\n                if used[i]:                  # 剪枝：已用過\n                    continue\n\n                path.append(nums[i])         # ① 做選擇\n                used[i] = True\n\n                backtrack()                  # ② 遞迴\n\n                path.pop()                   # ③ 撤銷選擇\n                used[i] = False\n\n        backtrack()\n        return result\n\n\n# 方法 B：原地交換\nclass Solution:\n    def permute(self, nums: List[int]) -> List[List[int]]:\n        result = []\n\n        def backtrack(first):\n            if first == len(nums):\n                result.append(nums[:])\n                return\n            for i in range(first, len(nums)):\n                nums[first], nums[i] = nums[i], nums[first]   # 交換\n                backtrack(first + 1)\n                nums[first], nums[i] = nums[i], nums[first]   # 換回來\n\n        backtrack(0)\n        return result","cpp":"// 方法 A：used 陣列（推薦）\nclass Solution {\n    vector<vector<int>> result;\n    vector<int> path;\n    vector<bool> used;\n\n    void backtrack(vector<int>& nums) {\n        if (path.size() == nums.size()) {\n            result.push_back(path);          // 記錄一組完整排列\n            return;\n        }\n\n        for (int i = 0; i < nums.size(); i++) {\n            if (used[i]) continue;           // 剪枝\n\n            path.push_back(nums[i]);         // ① 做選擇\n            used[i] = true;\n\n            backtrack(nums);                 // ② 遞迴\n\n            path.pop_back();                 // ③ 撤銷選擇\n            used[i] = false;\n        }\n    }\n\npublic:\n    vector<vector<int>> permute(vector<int>& nums) {\n        used.assign(nums.size(), false);\n        backtrack(nums);\n        return result;\n    }\n};\n\n// 方法 B：原地交換\nclass Solution {\n    vector<vector<int>> result;\n    void backtrack(vector<int>& nums, int first) {\n        if (first == nums.size()) { result.push_back(nums); return; }\n        for (int i = first; i < nums.size(); i++) {\n            swap(nums[first], nums[i]);\n            backtrack(nums, first + 1);\n            swap(nums[first], nums[i]);      // 換回來\n        }\n    }\npublic:\n    vector<vector<int>> permute(vector<int>& nums) {\n        backtrack(nums, 0);\n        return result;\n    }\n};","java":"// 方法 A：used 陣列（推薦）\nclass Solution {\n    private List<List<Integer>> result = new ArrayList<>();\n    private List<Integer> path = new ArrayList<>();\n    private boolean[] used;\n\n    public List<List<Integer>> permute(int[] nums) {\n        used = new boolean[nums.length];\n        backtrack(nums);\n        return result;\n    }\n\n    private void backtrack(int[] nums) {\n        if (path.size() == nums.length) {\n            result.add(new ArrayList<>(path));   // 必須複製一份！\n            return;\n        }\n\n        for (int i = 0; i < nums.length; i++) {\n            if (used[i]) continue;               // 剪枝\n\n            path.add(nums[i]);                   // ① 做選擇\n            used[i] = true;\n\n            backtrack(nums);                     // ② 遞迴\n\n            path.remove(path.size() - 1);        // ③ 撤銷選擇\n            used[i] = false;\n        }\n    }\n}","typescript":"// 回溯 + used 陣列標記已選過的元素\n// 時間複雜度: O(n · n!)，空間複雜度: O(n)\nfunction permute(nums: number[]): number[][] {\n    const result: number[][] = [];\n    const path: number[] = [];\n    const used = new Array(nums.length).fill(false);\n\n    const backtrack = (): void => {\n        if (path.length === nums.length) {\n            result.push([...path]);\n            return;\n        }\n        for (let i = 0; i < nums.length; i++) {\n            if (used[i]) continue;\n            used[i] = true;\n            path.push(nums[i]);\n            backtrack();\n            path.pop();\n            used[i] = false;\n        }\n    };\n\n    backtrack();\n    return result;\n}\n","c":"// 原地交換回溯：把第 k 個位置依序換成後面每一個元素（n ≤ 6，最多 720 種）\n// 時間複雜度: O(n · n!)，空間複雜度: O(n)\nstatic int** result;\nstatic int count;\n\nstatic void swap(int* a, int* b) { int t = *a; *a = *b; *b = t; }\n\nstatic void backtrack(int* nums, int n, int k) {\n    if (k == n) {\n        result[count] = malloc(sizeof(int) * n);\n        memcpy(result[count++], nums, sizeof(int) * n);\n        return;\n    }\n    for (int i = k; i < n; i++) {\n        swap(&nums[k], &nums[i]);\n        backtrack(nums, n, k + 1);\n        swap(&nums[k], &nums[i]);                 // 還原\n    }\n}\n\nint** permute(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {\n    int total = 1;\n    for (int i = 2; i <= numsSize; i++) total *= i;\n    result = malloc(sizeof(int*) * total);\n    count = 0;\n    backtrack(nums, numsSize, 0);\n    *returnSize = count;\n    *returnColumnSizes = malloc(sizeof(int) * total);\n    for (int i = 0; i < total; i++) (*returnColumnSizes)[i] = numsSize;\n    return result;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        int lc_rs = 0;\n        int *lc_rcs = NULL;\n        lc_t0 = lc_now();\n        int** lc_r = permute(a0, a0n, &lc_rs, &lc_rcs);\n        lc_ms = lc_now() - lc_t0;\n        lbc_igrid(&lc_o, lc_r, lc_rs, lc_rcs);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->permute(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}