378,3276,20475,98280,376740,1184040,3108105,6906900,13123110,21474180,30421755,37442160,40116600,37442160,30421755,21474180,13123110,6906900,3108105,1184040,376740,98280,20475,3276,378,28,1],[1,29,406,3654,23751,118755,475020,1560780,4292145,10015005,20030010,34597290,51895935,67863915,77558760,77558760,67863915,51895935,34597290,20030010,10015005,4292145,1560780,475020,118755,23751,3654,406,29,1]]}],"ref":"// 每一列頭尾是 1，中間等於上一列相鄰兩數之和\n// 時間複雜度: O(n²)，空間複雜度: O(1)（不含輸出）\nfunction generate(numRows) {\n    const result = [];\n    for (let i = 0; i < numRows; i++) {\n        const row = new Array(i + 1).fill(1);\n        for (let j = 1; j < i; j++)\n            row[j] = result[i - 1][j - 1] + result[i - 1][j];\n        result.push(row);\n    }\n    return result;\n}\n","solutions":{"python":"class Solution:\n    def generate(self, numRows: int) -> List[List[int]]:\n        \"\"\"\n        動態規劃\n        時間複雜度: O(numRows²)\n        空間複雜度: O(1)，不計算輸出空間\n        \"\"\"\n        result = []\n        \n        for i in range(numRows):\n            # 創建新行，初始化為全 1\n            row = [1] * (i + 1)\n            \n            # 填充中間元素\n            for j in range(1, i):\n                row[j] = result[i-1][j-1] + result[i-1][j]\n            \n            result.append(row)\n        \n        return result\n    \n    def generate_v2(self, numRows: int) -> List[List[int]]:\n        \"\"\"\n        另一種寫法：不預先初始化\n        \"\"\"\n        result = []\n        \n        for i in range(numRows):\n            row = []\n            for j in range(i + 1):\n                if j == 0 or j == i:\n                    # 首尾是 1\n                    row.append(1)\n                else:\n                    # 中間元素\n                    row.append(result[i-1][j-1] + result[i-1][j])\n            result.append(row)\n        \n        return result","cpp":"#include <vector>\nusing namespace std;\n\nclass Solution {\npublic:\n    /**\n     * 動態規劃\n     * 時間複雜度: O(numRows²)\n     * 空間複雜度: O(1)\n     */\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> result;\n        \n        for (int i = 0; i < numRows; i++) {\n            vector<int> row(i + 1, 1);\n            \n            for (int j = 1; j < i; j++) {\n                row[j] = result[i-1][j-1] + result[i-1][j];\n            }\n            \n            result.push_back(row);\n        }\n        \n        return result;\n    }\n};","java":"import java.util.ArrayList;\nimport java.util.List;\n\nclass Solution {\n    /**\n     * 動態規劃\n     * 時間複雜度: O(numRows²)\n     * 空間複雜度: O(1)\n     */\n    public List<List<Integer>> generate(int numRows) {\n        List<List<Integer>> result = new ArrayList<>();\n        \n        for (int i = 0; i < numRows; i++) {\n            List<Integer> row = new ArrayList<>();\n            \n            for (int j = 0; j <= i; j++) {\n                if (j == 0 || j == i) {\n                    row.add(1);\n                } else {\n                    int sum = result.get(i-1).get(j-1) + result.get(i-1).get(j);\n                    row.add(sum);\n                }\n            }\n            \n            result.add(row);\n        }\n        \n        return result;\n    }\n}","typescript":"// 每一列頭尾是 1，中間等於上一列相鄰兩數之和\n// 時間複雜度: O(n²)，空間複雜度: O(1)（不含輸出）\nfunction generate(numRows: number): number[][] {\n    const result: number[][] = [];\n    for (let i = 0; i < numRows; i++) {\n        const row = new Array(i + 1).fill(1);\n        for (let j = 1; j < i; j++) row[j] = result[i - 1][j - 1] + result[i - 1][j];\n        result.push(row);\n    }\n    return result;\n}\n","c":"// 每一列頭尾是 1，中間等於上一列相鄰兩數之和\n// 時間複雜度: O(n²)，空間複雜度: O(1)（不含輸出）\nint** generate(int numRows, int* returnSize, int** returnColumnSizes) {\n    int** result = malloc(sizeof(int*) * numRows);\n    *returnColumnSizes = malloc(sizeof(int) * numRows);\n    for (int i = 0; i < numRows; i++) {\n        result[i] = malloc(sizeof(int) * (i + 1));\n        (*returnColumnSizes)[i] = i + 1;\n        result[i][0] = result[i][i] = 1;\n        for (int j = 1; j < i; j++) result[i][j] = result[i - 1][j - 1] + result[i - 1][j];\n    }\n    *returnSize = numRows;\n    return result;\n}\n"}}