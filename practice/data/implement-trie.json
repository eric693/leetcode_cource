,["cba"],["caba"],["bb"],["b"],["aa"],["bbc"],["aaac"],["cb"],["ac"]]],"out":[null,false,false,null,false,null,false,false,null,false,null,true,false,false,null,null,false,false,false,null,false,null]},{"args":[["Trie","insert","startsWith","insert","startsWith","startsWith","insert","insert","insert","insert","insert","insert","search","search","search","startsWith","insert","insert","insert","insert","startsWith","startsWith","startsWith","insert","insert","search","insert","insert","startsWith","startsWith","startsWith","insert","insert","startsWith","insert","search","insert","insert","search","search","startsWith","startsWith"],[[],["cbbbb"],["a"],["bcb"],["bccc"],["bacb"],["cb"],["bcb"],["bacb"],["ca"],["cbbab"],["aba"],["a"],["b"],["cabb"],["b"],["baccb"],["aabc"],["a"],["c"],["abcc"],["bbacc"],["bc"],["abcab"],["c"],["aab"],["cacaa"],["bccc"],["cc"],["c"],["aacab"],["aa"],["cccc"],["a"],["abba"],["caca"],["cbaab"],["c"],["abb"],["bc"],["ccb"],["cb"]]],"out":[null,null,false,null,false,false,null,null,null,null,null,null,false,false,false,true,null,null,null,null,false,false,true,null,null,false,null,null,false,true,false,null,null,true,null,false,null,null,false,false,false,true]}],"ref":"// 字典樹：每個節點有 26 個子節點與結尾標記\n// insert / search / startsWith 皆為 O(L)，空間複雜度: O(總字元數 × 26)\nclass TrieNode {\n    children = new Array(26).fill(null);\n    isEnd = false;\n}\nclass Trie {\n    root = new TrieNode();\n    insert(word) {\n        let node = this.root;\n        for (const ch of word) {\n            const i = ch.charCodeAt(0) - 97;\n            if (!node.children[i])\n                node.children[i] = new TrieNode();\n            node = node.children[i];\n        }\n        node.isEnd = true;\n    }\n    search(word) {\n        const node = this.find(word);\n        return node !== null && node.isEnd;\n    }\n    startsWith(prefix) {\n        return this.find(prefix) !== null;\n    }\n    find(s) {\n        let node = this.root;\n        for (const ch of s) {\n            node = node.children[ch.charCodeAt(0) - 97];\n            if (!node)\n                return null;\n        }\n        return node;\n    }\n}\n","solutions":{"python":"class Trie:\n\n    def __init__(self):\n        self.children = {}      # 字元 -> Trie 節點\n        self.is_end = False     # 是否為某個完整單字的結尾\n\n    def insert(self, word: str) -> None:\n        node = self\n        for ch in word:\n            if ch not in node.children:\n                node.children[ch] = Trie()      # 節點不存在就建立\n            node = node.children[ch]\n        node.is_end = True\n\n    def search(self, word: str) -> bool:\n        node = self._find(word)\n        return node is not None and node.is_end   # 必須是完整單字\n\n    def startsWith(self, prefix: str) -> bool:\n        return self._find(prefix) is not None     # 存在路徑即可\n\n    def _find(self, s: str):\n        # 沿著 s 往下走，回傳終點節點；走不通回傳 None\n        node = self\n        for ch in s:\n            if ch not in node.children:\n                return None\n            node = node.children[ch]\n        return node","cpp":"class Trie {\nprivate:\n    Trie* children[26];    // 只處理小寫 a-z\n    bool isEnd;\n\n    // 沿著 s 往下走，回傳終點節點；走不通回傳 nullptr\n    Trie* find(const string& s) {\n        Trie* node = this;\n        for (char c : s) {\n            int idx = c - 'a';\n            if (node->children[idx] == nullptr) return nullptr;\n            node = node->children[idx];\n        }\n        return node;\n    }\n\npublic:\n    Trie() : isEnd(false) {\n        for (int i = 0; i < 26; i++) children[i] = nullptr;\n    }\n\n    void insert(string word) {\n        Trie* node = this;\n        for (char c : word) {\n            int idx = c - 'a';\n            if (node->children[idx] == nullptr) {\n                node->children[idx] = new Trie();   // 節點不存在就建立\n            }\n            node = node->children[idx];\n        }\n        node->isEnd = true;\n    }\n\n    bool search(string word) {\n        Trie* node = find(word);\n        return node != nullptr && node->isEnd;      // 必須是完整單字\n    }\n\n    bool startsWith(string prefix) {\n        return find(prefix) != nullptr;             // 存在路徑即可\n    }\n};","java":"class Trie {\n    private Trie[] children;   // 26 個小寫字母\n    private boolean isEnd;\n\n    public Trie() {\n        children = new Trie[26];\n        isEnd = false;\n    }\n\n    public void insert(String word) {\n        Trie node = this;\n        for (char c : word.toCharArray()) {\n            int idx = c - 'a';\n            if (node.children[idx] == null) {\n                node.children[idx] = new Trie();    // 節點不存在就建立\n            }\n            node = node.children[idx];\n        }\n        node.isEnd = true;\n    }\n\n    public boolean search(String word) {\n        Trie node = find(word);\n        return node != null && node.isEnd;          // 必須是完整單字\n    }\n\n    public boolean startsWith(String prefix) {\n        return find(prefix) != null;                // 存在路徑即可\n    }\n\n    // 沿著 s 往下走，回傳終點節點；走不通回傳 null\n    private Trie find(String s) {\n        Trie node = this;\n        for (char c : s.toCharArray()) {\n            int idx = c - 'a';\n            if (node.children[idx] == null) return null;\n            node = node.children[idx];\n        }\n        return node;\n    }\n}","typescript":"// 字典樹：每個節點有 26 個子節點與結尾標記\n// insert / search / startsWith 皆為 O(L)，空間複雜度: O(總字元數 × 26)\nclass TrieNode {\n    children: (TrieNode | null)[] = new Array(26).fill(null);\n    isEnd = false;\n}\n\nclass Trie {\n    private root = new TrieNode();\n\n    insert(word: string): void {\n        let node = this.root;\n        for (const ch of word) {\n            const i = ch.charCodeAt(0) - 97;\n            if (!node.children[i]) node.children[i] = new TrieNode();\n            node = node.children[i]!;\n        }\n        node.isEnd = true;\n    }\n\n    search(word: string): boolean {\n        const node = this.find(word);\n        return node !== null && node.isEnd;\n    }\n\n    startsWith(prefix: string): boolean {\n        return this.find(prefix) !== null;\n    }\n\n    private find(s: string): TrieNode | null {\n        let node: TrieNode | null = this.root;\n        for (const ch of s) {\n            node = node.children[ch.charCodeAt(0) - 97];\n            if (!node) return null;\n        }\n        return node;\n    }\n}\n","c":"// 字典樹：每個節點有 26 個子節點與結尾標記\n// insert / search / startsWith 皆為 O(L)，空間複雜度: O(總字元數 × 26)\ntypedef struct Trie {\n    struct Trie* children[26];\n    bool isEnd;\n} Trie;\n\nTrie* trieCreate() {\n    return calloc(1, sizeof(Trie));          // calloc 會把子節點全設為 NULL\n}\n\nvoid trieInsert(Trie* obj, char* word) {\n    Trie* node = obj;\n    for (char* p = word; *p; p++) {\n        int i = *p - 'a';\n        if (!node->children[i]) node->children[i] = trieCreate();\n        node = node->children[i];\n    }\n    node->isEnd = true;\n}\n\nstatic Trie* find(Trie* obj, char* s) {\n    Trie* node = obj;\n    for (char* p = s; *p && node; p++) node = node->children[*p - 'a'];\n    return node;\n}\n\nbool trieSearch(Trie* obj, char* word) {\n    Trie* node = find(obj, word);\n    return node && node->isEnd;\n}\n\nbool trieStartsWith(Trie* obj, char* prefix) {\n    return find(obj, prefix) != NULL;\n}\n\nvoid trieFree(Trie* obj) {\n    if (!obj) return;\n    for (int i = 0; i < 26; i++) trieFree(obj->children[i]);\n    free(obj);\n}\n"}}