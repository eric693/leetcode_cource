l,null,null,null,null,427,null,364,763,720,null,null,null,null,null,null,null,null,null,null,780,643,null,-132,-549,-68,403,null,null,-158,-82,null,550,881,null,674,null,null,null,null,null,466]],"out":[[819],[-780,152],[896,199,-718],[42,-685,-570,-49,-129,760],[-323,-219,949,464,260,-705,859,987,603,135],[456,-160,169,334,225,723,-133,-58,428,-756,-148,-346,-302,-537,95,587,-121],[-693,-702,526,-30,397,695,258,-818,241,56],[446,-951,295,-805,-900,-390,555,-593],[427,364,763,720],[780,643],[-132,-549,-68],[403,-158,-82],[550,881,674],[466]]}],"ref":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// BFS：每輪處理一整層\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction levelOrder(root) {\n    const result = [];\n    if (!root)\n        return result;\n    let queue = [root];\n    while (queue.length) {\n        const level = [];\n        const next = [];\n        for (const node of queue) {\n            level.push(node.val);\n            if (node.left)\n                next.push(node.left);\n            if (node.right)\n                next.push(node.right);\n        }\n        result.push(level);\n        queue = next;\n    }\n    return result;\n}\n","solutions":{"python":"# Definition for a binary tree node.\n# class TreeNode:\n#     def __init__(self, val=0, left=None, right=None):\n#         self.val = val\n#         self.left = left\n#         self.right = right\n\nfrom collections import deque\nfrom typing import List, Optional\n\nclass Solution:\n    def levelOrder(self, root: Optional[TreeNode]) -> List[List[int]]:\n        \"\"\"\n        方法一：BFS（推薦）\n        時間複雜度: O(n)\n        空間複雜度: O(n)\n        \"\"\"\n        if not root:\n            return []\n        \n        result = []\n        queue = deque([root])\n        \n        while queue:\n            # 當前層的節點數量\n            level_size = len(queue)\n            current_level = []\n            \n            # 處理當前層的所有節點\n            for _ in range(level_size):\n                node = queue.popleft()\n                current_level.append(node.val)\n                \n                # 將下一層的節點加入佇列\n                if node.left:\n                    queue.append(node.left)\n                if node.right:\n                    queue.append(node.right)\n            \n            result.append(current_level)\n        \n        return result\n    \n    def levelOrder_dfs(self, root: Optional[TreeNode]) -> List[List[int]]:\n        \"\"\"\n        方法二：DFS\n        時間複雜度: O(n)\n        空間複雜度: O(h) - h 為樹高\n        \"\"\"\n        result = []\n        \n        def dfs(node, depth):\n            if not node:\n                return\n            \n            # 如果當前深度等於結果陣列長度，創建新層\n            if depth == len(result):\n                result.append([])\n            \n            # 將當前節點值加入對應層\n            result[depth].append(node.val)\n            \n            # 遞迴處理左右子樹\n            dfs(node.left, depth + 1)\n            dfs(node.right, depth + 1)\n        \n        dfs(root, 0)\n        return result","cpp":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     TreeNode *left;\n *     TreeNode *right;\n *     TreeNode() : val(0), left(nullptr), right(nullptr) {}\n *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}\n *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}\n * };\n */\n\n#include <vector>\n#include <queue>\n\nclass Solution {\npublic:\n    /**\n     * 方法一：BFS（推薦）\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    std::vector<std::vector<int>> levelOrder(TreeNode* root) {\n        if (!root) {\n            return {};\n        }\n        \n        std::vector<std::vector<int>> result;\n        std::queue<TreeNode*> queue;\n        queue.push(root);\n        \n        while (!queue.empty()) {\n            // 當前層的節點數量\n            int levelSize = queue.size();\n            std::vector<int> currentLevel;\n            \n            // 處理當前層的所有節點\n            for (int i = 0; i < levelSize; i++) {\n                TreeNode* node = queue.front();\n                queue.pop();\n                currentLevel.push_back(node->val);\n                \n                // 將下一層的節點加入佇列\n                if (node->left) {\n                    queue.push(node->left);\n                }\n                if (node->right) {\n                    queue.push(node->right);\n                }\n            }\n            \n            result.push_back(currentLevel);\n        }\n        \n        return result;\n    }\n    \n    /**\n     * 方法二：DFS\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(h)\n     */\n    std::vector<std::vector<int>> levelOrder_dfs(TreeNode* root) {\n        std::vector<std::vector<int>> result;\n        dfs(root, 0, result);\n        return result;\n    }\n    \nprivate:\n    void dfs(TreeNode* node, int depth, std::vector<std::vector<int>>& result) {\n        if (!node) {\n            return;\n        }\n        \n        // 如果當前深度等於結果陣列長度，創建新層\n        if (depth == result.size()) {\n            result.push_back({});\n        }\n        \n        // 將當前節點值加入對應層\n        result[depth].push_back(node->val);\n        \n        // 遞迴處理左右子樹\n        dfs(node->left, depth + 1, result);\n        dfs(node->right, depth + 1, result);\n    }\n};","java":"/**\n * Definition for a binary tree node.\n * public class TreeNode {\n *     int val;\n *     TreeNode left;\n *     TreeNode right;\n *     TreeNode() {}\n *     TreeNode(int val) { this.val = val; }\n *     TreeNode(int val, TreeNode left, TreeNode right) {\n *         this.val = val;\n *         this.left = left;\n *         this.right = right;\n *     }\n * }\n */\n\nimport java.util.*;\n\nclass Solution {\n    /**\n     * 方法一：BFS（推薦）\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    public List<List<Integer>> levelOrder(TreeNode root) {\n        List<List<Integer>> result = new ArrayList<>();\n        \n        if (root == null) {\n            return result;\n        }\n        \n        Queue<TreeNode> queue = new LinkedList<>();\n        queue.offer(root);\n        \n        while (!queue.isEmpty()) {\n            // 當前層的節點數量\n            int levelSize = queue.size();\n            List<Integer> currentLevel = new ArrayList<>();\n            \n            // 處理當前層的所有節點\n            for (int i = 0; i < levelSize; i++) {\n                TreeNode node = queue.poll();\n                currentLevel.add(node.val);\n                \n                // 將下一層的節點加入佇列\n                if (node.left != null) {\n                    queue.offer(node.left);\n                }\n                if (node.right != null) {\n                    queue.offer(node.right);\n                }\n            }\n            \n            result.add(currentLevel);\n        }\n        \n        return result;\n    }\n    \n    /**\n     * 方法二：DFS\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(h)\n     */\n    public List<List<Integer>> levelOrder_dfs(TreeNode root) {\n        List<List<Integer>> result = new ArrayList<>();\n        dfs(root, 0, result);\n        return result;\n    }\n    \n    private void dfs(TreeNode node, int depth, List<List<Integer>> result) {\n        if (node == null) {\n            return;\n        }\n        \n        // 如果當前深度等於結果陣列長度，創建新層\n        if (depth == result.size()) {\n            result.add(new ArrayList<>());\n        }\n        \n        // 將當前節點值加入對應層\n        result.get(depth).add(node.val);\n        \n        // 遞迴處理左右子樹\n        dfs(node.left, depth + 1, result);\n        dfs(node.right, depth + 1, result);\n    }\n}","typescript":"/**\n * Definition for a binary tree node.\n * class TreeNode {\n *     val: number\n *     left: TreeNode | null\n *     right: TreeNode | null\n * }\n */\n// BFS：每輪處理一整層\n// 時間複雜度: O(n)，空間複雜度: O(n)\nfunction levelOrder(root: TreeNode | null): number[][] {\n    const result: number[][] = [];\n    if (!root) return result;\n    let queue: TreeNode[] = [root];\n\n    while (queue.length) {\n        const level: number[] = [];\n        const next: TreeNode[] = [];\n        for (const node of queue) {\n            level.push(node.val);\n            if (node.left) next.push(node.left);\n            if (node.right) next.push(node.right);\n        }\n        result.push(level);\n        queue = next;\n    }\n    return result;\n}\n","c":"/**\n * Definition for a binary tree node.\n * struct TreeNode {\n *     int val;\n *     struct TreeNode *left;\n *     struct TreeNode *right;\n * };\n */\n// BFS：用陣列當佇列，每輪處理一整層\n// 時間複雜度: O(n)，空間複雜度: O(n)\n#define MAXN 2000\n\nint** levelOrder(struct TreeNode* root, int* returnSize, int** returnColumnSizes) {\n    int** result = malloc(sizeof(int*) * MAXN);\n    *returnColumnSizes = malloc(sizeof(int) * MAXN);\n    *returnSize = 0;\n    if (!root) return result;\n\n    struct TreeNode* queue[MAXN];\n    int head = 0, tail = 0;\n    queue[tail++] = root;\n\n    while (head < tail) {\n        int size = tail - head;                   // 這一層的節點數\n        int* level = malloc(sizeof(int) * size);\n        for (int i = 0; i < size; i++) {\n            struct TreeNode* node = queue[head++];\n            level[i] = node->val;\n            if (node->left) queue[tail++] = node->left;\n            if (node->right) queue[tail++] = node->right;\n        }\n        (*returnColumnSizes)[*returnSize] = size;\n        result[(*returnSize)++] = level;\n    }\n    return result;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        struct TreeNode *a0 = lcc_tree(&lc_c->a[0]);\n        int lc_rs = 0;\n        int *lc_rcs = NULL;\n        lc_t0 = lc_now();\n        int** lc_r = levelOrder(a0, &lc_rs, &lc_rcs);\n        lc_ms = lc_now() - lc_t0;\n        lbc_igrid(&lc_o, lc_r, lc_rs, lc_rcs);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        TreeNode* a0 = lcx::from<TreeNode*>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->levelOrder(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}