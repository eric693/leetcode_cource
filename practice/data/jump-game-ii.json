,0,3,5,2,2,5,6,1,6,5,6,2,5,5,0,5,4,2,0,3,4,6,1,4,0,6,4,4,0,5,3,2,4,4,3,0,1,1,1,3,2,5,4,0,6,4,4,1,5,6,0,3,4,1,3,2,5,5,1,6,3,6,3,2,6,5,4,2,5,6,0,3,3,4,3,3,2,3,6,3,6,6,3,2,5,5,4]],"out":2633}],"ref":"// 貪心（隱式 BFS）：在目前這一跳可到達的範圍內，找下一跳最遠能到哪\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction jump(nums) {\n    let jumps = 0, curEnd = 0, farthest = 0;\n    for (let i = 0; i < nums.length - 1; i++) {\n        farthest = Math.max(farthest, i + nums[i]);\n        if (i === curEnd) { // 走到這一跳的邊界，必須再跳一次\n            jumps++;\n            curEnd = farthest;\n        }\n    }\n    return jumps;\n}\n","solutions":{"python":"# 方法一：貪心算法（最優解）\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        n = len(nums)\n        if n <= 1:\n            return 0\n        \n        jumps = 0           # 跳躍次數\n        current_end = 0     # 當前跳躍的邊界\n        farthest = 0        # 能到達的最遠位置\n        \n        # 不需要遍歷最後一個元素\n        for i in range(n - 1):\n            # 更新能到達的最遠位置\n            farthest = max(farthest, i + nums[i])\n            \n            # 到達當前跳躍的邊界\n            if i == current_end:\n                jumps += 1\n                current_end = farthest\n                \n                # 優化：如果已經能到達終點，提前退出\n                if current_end >= n - 1:\n                    break\n        \n        return jumps\n\n\n# 方法二：BFS 思想\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        \"\"\"\n        把每次跳躍看作 BFS 的一層\n        \"\"\"\n        n = len(nums)\n        if n <= 1:\n            return 0\n        \n        jumps = 0\n        current_level_end = 0\n        next_level_end = 0\n        \n        for i in range(n - 1):\n            next_level_end = max(next_level_end, i + nums[i])\n            \n            if i == current_level_end:\n                jumps += 1\n                current_level_end = next_level_end\n        \n        return jumps\n\n\n# 方法三：動態規劃（較慢，但易理解）\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        \"\"\"\n        時間複雜度: O(n²)\n        空間複雜度: O(n)\n        \"\"\"\n        n = len(nums)\n        dp = [float('inf')] * n\n        dp[0] = 0\n        \n        for i in range(n):\n            # 從位置 i 能跳到的所有位置\n            for j in range(1, nums[i] + 1):\n                if i + j < n:\n                    dp[i + j] = min(dp[i + j], dp[i] + 1)\n        \n        return dp[n - 1]\n\n\n# 方法四：詳細註解版本\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        \"\"\"\n        貪心策略詳解版\n        \n        核心思想：\n        每次跳躍時，我們在當前能到達的範圍內\n        選擇能讓我們跳得最遠的位置\n        \"\"\"\n        n = len(nums)\n        \n        # 邊界情況\n        if n <= 1:\n            return 0\n        \n        jumps = 0        # 跳躍次數\n        current_end = 0  # 當前這一跳能到達的最遠邊界\n        farthest = 0     # 在當前範圍內，下一跳能到達的最遠位置\n        \n        # 遍歷到倒數第二個位置即可\n        # 因為最後一個位置是目標，不需要再跳\n        for i in range(n - 1):\n            # 更新在當前範圍內，下一跳能到達的最遠位置\n            farthest = max(farthest, i + nums[i])\n            \n            # 到達當前這一跳的邊界了\n            if i == current_end:\n                # 必須進行下一跳\n                jumps += 1\n                # 更新邊界為下一跳能到達的最遠位置\n                current_end = farthest\n                \n                # 提前退出優化\n                if current_end >= n - 1:\n                    break\n        \n        return jumps\n\n\n# 方法五：反向貪心（從後往前）\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        \"\"\"\n        從終點反向找，每次找能到達當前位置的最遠起點\n        時間複雜度: O(n²)，較慢\n        \"\"\"\n        n = len(nums)\n        jumps = 0\n        position = n - 1\n        \n        while position > 0:\n            # 找最左邊能一步到達 position 的位置\n            for i in range(position):\n                if i + nums[i] >= position:\n                    position = i\n                    jumps += 1\n                    break\n        \n        return jumps\n","cpp":"// 方法一：貪心算法（最優解）\nclass Solution {\npublic:\n    int jump(vector<int>& nums) {\n        int n = nums.size();\n        if (n <= 1) return 0;\n        \n        int jumps = 0;\n        int currentEnd = 0;\n        int farthest = 0;\n        \n        for (int i = 0; i < n - 1; i++) {\n            farthest = max(farthest, i + nums[i]);\n            \n            if (i == currentEnd) {\n                jumps++;\n                currentEnd = farthest;\n                \n                if (currentEnd >= n - 1) break;\n            }\n        }\n        \n        return jumps;\n    }\n};\n\n\n// 方法二：動態規劃\nclass Solution {\npublic:\n    int jump(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> dp(n, INT_MAX);\n        dp[0] = 0;\n        \n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j <= nums[i] && i + j < n; j++) {\n                dp[i + j] = min(dp[i + j], dp[i] + 1);\n            }\n        }\n        \n        return dp[n - 1];\n    }\n};\n","java":"// 方法一：貪心算法（最優解）\nclass Solution {\n    public int jump(int[] nums) {\n        int n = nums.length;\n        if (n <= 1) return 0;\n        \n        int jumps = 0;\n        int currentEnd = 0;\n        int farthest = 0;\n        \n        for (int i = 0; i < n - 1; i++) {\n            farthest = Math.max(farthest, i + nums[i]);\n            \n            if (i == currentEnd) {\n                jumps++;\n                currentEnd = farthest;\n                \n                if (currentEnd >= n - 1) break;\n            }\n        }\n        \n        return jumps;\n    }\n}\n\n\n// 方法二：動態規劃\nclass Solution {\n    public int jump(int[] nums) {\n        int n = nums.length;\n        int[] dp = new int[n];\n        Arrays.fill(dp, Integer.MAX_VALUE);\n        dp[0] = 0;\n        \n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j <= nums[i] && i + j < n; j++) {\n                dp[i + j] = Math.min(dp[i + j], dp[i] + 1);\n            }\n        }\n        \n        return dp[n - 1];\n    }\n}\n","typescript":"// 貪心（隱式 BFS）：在目前這一跳可到達的範圍內，找下一跳最遠能到哪\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction jump(nums: number[]): number {\n    let jumps = 0, curEnd = 0, farthest = 0;\n    for (let i = 0; i < nums.length - 1; i++) {\n        farthest = Math.max(farthest, i + nums[i]);\n        if (i === curEnd) {        // 走到這一跳的邊界，必須再跳一次\n            jumps++;\n            curEnd = farthest;\n        }\n    }\n    return jumps;\n}\n","c":"// 貪心（隱式 BFS）：在目前這一跳可到達的範圍內，找下一跳最遠能到哪\n// 時間複雜度: O(n)，空間複雜度: O(1)\nint jump(int* nums, int numsSize) {\n    int jumps = 0, curEnd = 0, farthest = 0;\n    for (int i = 0; i < numsSize - 1; i++) {\n        if (i + nums[i] > farthest) farthest = i + nums[i];\n        if (i == curEnd) {         // 走到這一跳的邊界，必須再跳一次\n            jumps++;\n            curEnd = farthest;\n        }\n    }\n    return jumps;\n}\n"}}