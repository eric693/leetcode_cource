05991374},{"args":[[-881151553,-881151553,-881151553,-134870131,-881151553,-342869067,330910531,-361822853,-881151553,25854857,-881151553,-881151553,-256335211,-881151553,-881151553,-881151553,-881151553,-881151553,-881151553,-881151553,-881151553,-291236202,940258313,-881151553,995280950,-881151553,-598421068,-881151553,-881151553,-228805280,-656827829,967160853,-881151553,-957509835,-881151553,-881151553,-909688912,-344319478,-881151553,-765930202,573395168,55734696,-861461278,-870535907,-672640437,790318543,-881151553,-881151553,-881151553,-881151553,-881151553,-518718487,-881151553,-106953719,-881151553,-386685888,-881151553,828911935,846773261,-328624522]],"out":-881151553}],"ref":"// Boyer-Moore 投票法：不同的數兩兩抵銷，最後剩下的就是眾數\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction majorityElement(nums) {\n    let candidate = 0, count = 0;\n    for (const x of nums) {\n        if (count === 0)\n            candidate = x;\n        count += x === candidate ? 1 : -1;\n    }\n    return candidate;\n}\n","solutions":{"python":"class Solution:\n    def majorityElement(self, nums: List[int]) -> int:\n        \"\"\"\n        方法一：Boyer-Moore 投票算法（最優）\n        時間複雜度: O(n)\n        空間複雜度: O(1)\n        \"\"\"\n        candidate = None\n        count = 0\n        \n        # 找出候選人\n        for num in nums:\n            if count == 0:\n                candidate = num\n            count += 1 if num == candidate else -1\n        \n        return candidate\n    \n    def majorityElement_hashmap(self, nums: List[int]) -> int:\n        \"\"\"\n        方法二：HashMap 計數\n        時間複雜度: O(n)\n        空間複雜度: O(n)\n        \"\"\"\n        from collections import Counter\n        counts = Counter(nums)\n        return max(counts.keys(), key=counts.get)\n        \n        # 或者\n        # for num, count in counts.items():\n        #     if count > len(nums) // 2:\n        #         return num\n    \n    def majorityElement_sort(self, nums: List[int]) -> int:\n        \"\"\"\n        方法三：排序\n        時間複雜度: O(n log n)\n        空間複雜度: O(1)\n        \"\"\"\n        nums.sort()\n        return nums[len(nums) // 2]\n    \n    def majorityElement_random(self, nums: List[int]) -> int:\n        \"\"\"\n        方法四：隨機化\n        期望時間複雜度: O(n)\n        \"\"\"\n        import random\n        \n        while True:\n            candidate = random.choice(nums)\n            if nums.count(candidate) > len(nums) // 2:\n                return candidate","cpp":"#include <vector>\n#include <unordered_map>\n#include <algorithm>\nusing namespace std;\n\nclass Solution {\npublic:\n    /**\n     * 方法一：Boyer-Moore 投票算法\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(1)\n     */\n    int majorityElement(vector<int>& nums) {\n        int candidate = 0;\n        int count = 0;\n        \n        for (int num : nums) {\n            if (count == 0) {\n                candidate = num;\n            }\n            count += (num == candidate) ? 1 : -1;\n        }\n        \n        return candidate;\n    }\n    \n    /**\n     * 方法二：HashMap 計數\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    int majorityElement_hashmap(vector<int>& nums) {\n        unordered_map<int, int> counts;\n        int n = nums.size();\n        \n        for (int num : nums) {\n            counts[num]++;\n            if (counts[num] > n / 2) {\n                return num;\n            }\n        }\n        \n        return -1;  // 不會執行到這裡\n    }\n    \n    /**\n     * 方法三：排序\n     * 時間複雜度: O(n log n)\n     * 空間複雜度: O(1)\n     */\n    int majorityElement_sort(vector<int>& nums) {\n        sort(nums.begin(), nums.end());\n        return nums[nums.size() / 2];\n    }\n};","java":"import java.util.HashMap;\nimport java.util.Map;\nimport java.util.Arrays;\n\nclass Solution {\n    /**\n     * 方法一：Boyer-Moore 投票算法\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(1)\n     */\n    public int majorityElement(int[] nums) {\n        int candidate = 0;\n        int count = 0;\n        \n        for (int num : nums) {\n            if (count == 0) {\n                candidate = num;\n            }\n            count += (num == candidate) ? 1 : -1;\n        }\n        \n        return candidate;\n    }\n    \n    /**\n     * 方法二：HashMap 計數\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(n)\n     */\n    public int majorityElement_hashmap(int[] nums) {\n        Map<Integer, Integer> counts = new HashMap<>();\n        int n = nums.length;\n        \n        for (int num : nums) {\n            counts.put(num, counts.getOrDefault(num, 0) + 1);\n            if (counts.get(num) > n / 2) {\n                return num;\n            }\n        }\n        \n        return -1;  // 不會執行到這裡\n    }\n    \n    /**\n     * 方法三：排序\n     * 時間複雜度: O(n log n)\n     * 空間複雜度: O(1)\n     */\n    public int majorityElement_sort(int[] nums) {\n        Arrays.sort(nums);\n        return nums[nums.length / 2];\n    }\n}","typescript":"// Boyer-Moore 投票法：不同的數兩兩抵銷，最後剩下的就是眾數\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction majorityElement(nums: number[]): number {\n    let candidate = 0, count = 0;\n    for (const x of nums) {\n        if (count === 0) candidate = x;\n        count += x === candidate ? 1 : -1;\n    }\n    return candidate;\n}\n","c":"// Boyer-Moore 投票法：不同的數兩兩抵銷，最後剩下的就是眾數\n// 時間複雜度: O(n)，空間複雜度: O(1)\nint majorityElement(int* nums, int numsSize) {\n    int candidate = 0, count = 0;\n    for (int i = 0; i < numsSize; i++) {\n        if (count == 0) candidate = nums[i];\n        count += (nums[i] == candidate) ? 1 : -1;\n    }\n    return candidate;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        lc_t0 = lc_now();\n        int lc_r = majorityElement(a0, a0n);\n        lc_ms = lc_now() - lc_t0;\n        lb_ll(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->majorityElement(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}