,-32,7,-35,-7,32,5,-22,19,27,-43,-18,-33,22,26,-13,-30,4,-46,-31,-20,-28,-6,-39,-31,40,-43,-12,32,-15,-22,-42,-50,-27,-3,-47,-36,-35,-20,-9,50,23,-33,13,18,15,-27,-35,-50,-19,-23,14,13,-25,40,36,-45,34,-24,-6,-7,18,-39,-13,-12,18,-18,-23,-3,-17,3,-48,2,1,13,25,-22,-12,-21,-2,4,8,-44,-28,-1,1,-8,30,-23,-49,-39,13,23,-17,-12,-2,23,13,-4,5,7,29,35,-38,-49,44,29,15,-50,19,44,-3,-21,-13,2,-48,-49,-31,5,-47,-5,-17,-46,14,-9,-2,12,47,31,-25,11,-49,-45,20,46,10,8,31,41,5,-1,-30,44,15,31,-3,-7,-33,-30,-24,34,-13,7,18,-26,-50,-28,23,7,14,17,-12,15,10,46,-25,2,-29,15,47,-42,-14,18,16,-18,-20,24,-42,37,-3,9,38,-45,-11,24,-23,-5,4,-30,28,-11,6,-34,-10,-43,-21,20,15,34,-19,36,-36,-6,-33,-18,16,-26,-12,14,-6]],"out":223},{"args":[[29,-21,14,20,29,-8,48,-35,-22,6,-41,0,1,-48,27,-12,30,-4,-20,-44,14,37,-13,8,-3,-23,-19,-24,8,27,35,26,-5,7,29,-28,-37,38,-3,-39,38,44,7,-37,-5,6,32,19,-42,-19,24,-11,36,-27,-15,1,-22,-2,44,2,29,-45,19,14,19,-27,50,6,-44,33,-44,-36,12,7,-5,-25,28,-26,-46,-37,-28,10,22,23,-9,8,-50,-7,-35,-41,9,42,29,-45,13,21,16,-23,0,-30,39,-45,35,29,-43,-29,5,-10,25,21,-27,-7,-10,17,-46,32,34,-28,-2,31,-38,-6,50,-38]],"out":66},{"args":[[-45,-1,7,36,-16,-5,-45,15,-17,-39,31,41,-15,-14,-8,46,18,-12,46,-49,40,-25,-34,16,-47]],"out":15}],"ref":"// 二分：往上坡方向走一定會遇到峰值\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nfunction findPeakElement(nums) {\n    let left = 0, right = nums.length - 1;\n    while (left < right) {\n        const mid = (left + right) >> 1;\n        if (nums[mid] < nums[mid + 1])\n            left = mid + 1; // 右邊在上坡\n        else\n            right = mid;\n    }\n    return left;\n}\n","solutions":{"python":"# 二分搜尋：往上坡方向走（推薦）\nclass Solution:\n    def findPeakElement(self, nums: List[int]) -> int:\n        left, right = 0, len(nums) - 1\n\n        while left < right:\n            mid = left + (right - left) // 2\n            if nums[mid] < nums[mid + 1]:\n                left = mid + 1          # 上坡，右半邊必有峰值\n            else:\n                right = mid             # 下坡，mid 可能就是峰值\n        return left\n\n\n# 線性掃描版本（O(n)，不符要求但可當作驗證）\nclass Solution:\n    def findPeakElement(self, nums: List[int]) -> int:\n        for i in range(len(nums) - 1):\n            if nums[i] > nums[i + 1]:   # 第一個下降處就是峰值\n                return i\n        return len(nums) - 1            # 全程上升，最後一個是峰值","cpp":"// 二分搜尋：往上坡方向走（推薦）\nclass Solution {\npublic:\n    int findPeakElement(vector<int>& nums) {\n        int left = 0, right = nums.size() - 1;\n\n        while (left < right) {\n            int mid = left + (right - left) / 2;\n            if (nums[mid] < nums[mid + 1]) {\n                left = mid + 1;      // 上坡，右半邊必有峰值\n            } else {\n                right = mid;         // 下坡，mid 可能就是峰值\n            }\n        }\n        return left;\n    }\n};\n\n// 遞迴版本\nclass Solution {\n    int search(vector<int>& nums, int left, int right) {\n        if (left == right) return left;\n        int mid = left + (right - left) / 2;\n        if (nums[mid] < nums[mid + 1]) return search(nums, mid + 1, right);\n        return search(nums, left, mid);\n    }\npublic:\n    int findPeakElement(vector<int>& nums) {\n        return search(nums, 0, nums.size() - 1);\n    }\n};","java":"// 二分搜尋：往上坡方向走（推薦）\nclass Solution {\n    public int findPeakElement(int[] nums) {\n        int left = 0, right = nums.length - 1;\n\n        while (left < right) {\n            int mid = left + (right - left) / 2;\n            if (nums[mid] < nums[mid + 1]) {\n                left = mid + 1;      // 上坡\n            } else {\n                right = mid;         // 下坡\n            }\n        }\n        return left;\n    }\n}","typescript":"// 二分：往上坡方向走一定會遇到峰值\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nfunction findPeakElement(nums: number[]): number {\n    let left = 0, right = nums.length - 1;\n    while (left < right) {\n        const mid = (left + right) >> 1;\n        if (nums[mid] < nums[mid + 1]) left = mid + 1;   // 右邊在上坡\n        else right = mid;\n    }\n    return left;\n}\n","c":"// 二分：往上坡方向走一定會遇到峰值\n// 時間複雜度: O(log n)，空間複雜度: O(1)\nint findPeakElement(int* nums, int numsSize) {\n    int left = 0, right = numsSize - 1;\n    while (left < right) {\n        int mid = left + (right - left) / 2;\n        if (nums[mid] < nums[mid + 1]) left = mid + 1;   // 右邊在上坡\n        else right = mid;\n    }\n    return left;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        lc_t0 = lc_now();\n        int lc_r = findPeakElement(a0, a0n);\n        lc_ms = lc_now() - lc_t0;\n        lb_ll(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->findPeakElement(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}