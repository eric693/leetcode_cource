360502159,430927243,-1964262855,-1172016648,1432209028,1390643883,360502159,-1172016648,1720988201,1228822012,974615534,-1326228076,-1309251238,-683867756,-601516013,1131102892,-1964262855,1094862870,-1338197277,-1770469899,-1461599130]],"out":[1319672653,974615534]},{"args":[[-899786783,110038584,-1788743089,1244243791,421714128,239380460,1549247820,1549247820,1439235389,929763598,-1069432795,388396291,388396291,296824295,110038584,52187199,-1069432795,5912031,-899786783,929763598,-1813248107,1244243791,-1779266625,-538793692,-1779266625,1937545965,1122313581,-1813248107,1122313581,1439235389,-424394704,239380460,5912031,1937545965,296824295,38450533,421714128,-538793692,52187199,-647285505,-424394704,-647285505]],"out":[-1788743089,38450533]},{"args":[[-1639564615,300924065,697560307,697560307,-692882050,-992557058,1965347873,1965347873,102268415,-974712257,-692882050,102268415,-992557058,-974712257]],"out":[-1639564615,300924065]},{"args":[[1707979301,1838455870,522957006,-766392338,-293249465,1342861319,1838455870,855272632,1596871719,-1945740008,1707979301,1342861319,522957006,1910963544,-766392338,855272632,1596871719,1910963544]],"out":[-293249465,-1945740008]},{"args":[[-1574099111,70800583,-1960805912,-2093048856,-957266731,-1574099111,-634068804,-2093048856,-957266731,-1960805912]],"out":[70800583,-634068804]}],"ref":"// 全部 XOR 得到 a ^ b，用最低位的 1 把數字分成兩組，各組再 XOR\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction singleNumber(nums) {\n    let xor = 0;\n    for (const x of nums)\n        xor ^= x;\n    const lowbit = xor & -xor; // a 與 b 在這一位不同\n    let a = 0, b = 0;\n    for (const x of nums) {\n        if (x & lowbit)\n            a ^= x;\n        else\n            b ^= x;\n    }\n    return [a, b];\n}\n","solutions":{"python":"# XOR + lowbit 分組（標準解）\nclass Solution:\n    def singleNumber(self, nums: List[int]) -> List[int]:\n        # 第一步：全部 XOR，得到 a ^ b\n        xor_all = 0\n        for num in nums:\n            xor_all ^= num\n\n        # 第二步：取出最低位的 1（a 和 b 在這一位不同）\n        lowbit = xor_all & (-xor_all)\n\n        # 第三步：依這一位分兩組，各自 XOR\n        a = b = 0\n        for num in nums:\n            if num & lowbit:\n                a ^= num\n            else:\n                b ^= num\n        return [a, b]\n\n\n# 對照組：用 HashMap（O(n) 空間，不符要求但好懂）\nclass Solution:\n    def singleNumber(self, nums: List[int]) -> List[int]:\n        from collections import Counter\n        return [k for k, v in Counter(nums).items() if v == 1]","cpp":"// XOR + lowbit 分組（標準解）\nclass Solution {\npublic:\n    vector<int> singleNumber(vector<int>& nums) {\n        // 第一步：全部 XOR，得到 a ^ b\n        long long xorAll = 0;\n        for (int num : nums) xorAll ^= num;\n\n        // 第二步：取最低位的 1（用 long long 避免 INT_MIN 溢位）\n        int lowbit = (int)(xorAll & -xorAll);\n\n        // 第三步：分組 XOR\n        int a = 0, b = 0;\n        for (int num : nums) {\n            if (num & lowbit) a ^= num;\n            else              b ^= num;\n        }\n        return {a, b};\n    }\n};","java":"// XOR + lowbit 分組（標準解）\nclass Solution {\n    public int[] singleNumber(int[] nums) {\n        // 第一步：全部 XOR，得到 a ^ b\n        int xorAll = 0;\n        for (int num : nums) xorAll ^= num;\n\n        // 第二步：取最低位的 1\n        // 注意 xorAll == Integer.MIN_VALUE 時 -xorAll 仍等於自己，剛好正確\n        int lowbit = xorAll & (-xorAll);\n\n        // 第三步：分組 XOR\n        int a = 0, b = 0;\n        for (int num : nums) {\n            if ((num & lowbit) != 0) a ^= num;\n            else                     b ^= num;\n        }\n        return new int[]{a, b};\n    }\n}","typescript":"// 全部 XOR 得到 a ^ b，用最低位的 1 把數字分成兩組，各組再 XOR\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction singleNumber(nums: number[]): number[] {\n    let xor = 0;\n    for (const x of nums) xor ^= x;\n    const lowbit = xor & -xor;              // a 與 b 在這一位不同\n    let a = 0, b = 0;\n    for (const x of nums) {\n        if (x & lowbit) a ^= x;\n        else b ^= x;\n    }\n    return [a, b];\n}\n","c":"// 全部 XOR 得到 a ^ b，用最低位的 1 把數字分成兩組，各組再 XOR\n// 時間複雜度: O(n)，空間複雜度: O(1)\nint* singleNumber(int* nums, int numsSize, int* returnSize) {\n    unsigned int xor = 0;\n    for (int i = 0; i < numsSize; i++) xor ^= (unsigned int)nums[i];\n    unsigned int lowbit = xor & (~xor + 1);  // 用無號數避免 INT_MIN 取負溢位\n    int a = 0, b = 0;\n    for (int i = 0; i < numsSize; i++) {\n        if ((unsigned int)nums[i] & lowbit) a ^= nums[i];\n        else b ^= nums[i];\n    }\n    int* ans = malloc(sizeof(int) * 2);\n    ans[0] = a;\n    ans[1] = b;\n    *returnSize = 2;\n    return ans;\n}\n"}}