"()()((((())))())","()()((((()))))()","()()(((()(()))))","()()(((()()())))","()()(((()())()))","()()(((()()))())","()()(((()())))()","()()(((())(())))","()()(((())()()))","()()(((())())())","()()(((())()))()","()()(((()))(()))","()()(((()))()())","()()(((()))())()","()()(((())))(())","()()(((())))()()","()()((()((()))))","()()((()(()())))","()()((()(())()))","()()((()(()))())","()()((()(())))()","()()((()()(())))","()()((()()()()))","()()((()()())())","()()((()()()))()","()()((()())(()))","()()((()())()())","()()((()())())()","()()((()()))(())","()()((()()))()()","()()((())((())))","()()((())(()()))","()()((())(())())","()()((())(()))()","()()((())()(()))","()()((())()()())","()()((())()())()","()()((())())(())","()()((())())()()","()()((()))((()))","()()((()))(()())","()()((()))(())()","()()((()))()(())","()()((()))()()()","()()(()(((()))))","()()(()((()())))","()()(()((())()))","()()(()((()))())","()()(()((())))()","()()(()(()(())))","()()(()(()()()))","()()(()(()())())","()()(()(()()))()","()()(()(())(()))","()()(()(())()())","()()(()(())())()","()()(()(()))(())","()()(()(()))()()","()()(()()((())))","()()(()()(()()))","()()(()()(())())","()()(()()(()))()","()()(()()()(()))","()()(()()()()())","()()(()()()())()","()()(()()())(())","()()(()()())()()","()()(()())((()))","()()(()())(()())","()()(()())(())()","()()(()())()(())","()()(()())()()()","()()(())(((())))","()()(())((()()))","()()(())((())())","()()(())((()))()","()()(())(()(()))","()()(())(()()())","()()(())(()())()","()()(())(())(())","()()(())(())()()","()()(())()((()))","()()(())()(()())","()()(())()(())()","()()(())()()(())","()()(())()()()()","()()()((((()))))","()()()(((()())))","()()()(((())()))","()()()(((()))())","()()()(((())))()","()()()((()(())))","()()()((()()()))","()()()((()())())","()()()((()()))()","()()()((())(()))","()()()((())()())","()()()((())())()","()()()((()))(())","()()()((()))()()","()()()(()((())))","()()()(()(()()))","()()()(()(())())","()()()(()(()))()","()()()(()()(()))","()()()(()()()())","()()()(()()())()","()()()(()())(())","()()()(()())()()","()()()(())((()))","()()()(())(()())","()()()(())(())()","()()()(())()(())","()()()(())()()()","()()()()(((())))","()()()()((()()))","()()()()((())())","()()()()((()))()","()()()()(()(()))","()()()()(()()())","()()()()(()())()","()()()()(())(())","()()()()(())()()","()()()()()((()))","()()()()()(()())","()()()()()(())()","()()()()()()(())","()()()()()()()()"]}],"ref":"// 回溯：左括號數 < n 可放左括號，右括號數 < 左括號數可放右括號\n// 時間複雜度: O(4^n / √n)，空間複雜度: O(n)\nfunction generateParenthesis(n) {\n    const result = [];\n    const backtrack = (path, open, close) => {\n        if (path.length === 2 * n) {\n            result.push(path);\n            return;\n        }\n        if (open < n)\n            backtrack(path + '(', open + 1, close);\n        if (close < open)\n            backtrack(path + ')', open, close + 1);\n    };\n    backtrack('', 0, 0);\n    return result;\n}\n","solutions":{"python":"# 回溯 + 剪枝（推薦）\nclass Solution:\n    def generateParenthesis(self, n: int) -> List[str]:\n        result = []\n        path = []\n\n        def backtrack(open_count, close_count):\n            # 終止條件：用完所有括號\n            if len(path) == 2 * n:\n                result.append(''.join(path))\n                return\n\n            # 規則 1：左括號還沒用完就可以放\n            if open_count < n:\n                path.append('(')\n                backtrack(open_count + 1, close_count)\n                path.pop()\n\n            # 規則 2：右括號數量不能超過左括號\n            if close_count < open_count:\n                path.append(')')\n                backtrack(open_count, close_count + 1)\n                path.pop()\n\n        backtrack(0, 0)\n        return result\n\n\n# 方法二：動態規劃（按「第一個括號配對的位置」分割）\nclass Solution:\n    def generateParenthesis(self, n: int) -> List[str]:\n        # dp[i] = i 對括號的所有合法組合\n        dp = [[] for _ in range(n + 1)]\n        dp[0] = ['']\n\n        for i in range(1, n + 1):\n            for j in range(i):\n                # 形式：( 內部 j 對 ) 外部 i-1-j 對\n                for inner in dp[j]:\n                    for outer in dp[i - 1 - j]:\n                        dp[i].append('(' + inner + ')' + outer)\n        return dp[n]","cpp":"// 回溯 + 剪枝（推薦）\nclass Solution {\n    vector<string> result;\n    string path;\n\n    void backtrack(int n, int openCount, int closeCount) {\n        if (path.size() == 2 * n) {\n            result.push_back(path);\n            return;\n        }\n\n        // 規則 1：左括號還沒用完\n        if (openCount < n) {\n            path.push_back('(');\n            backtrack(n, openCount + 1, closeCount);\n            path.pop_back();\n        }\n\n        // 規則 2：右括號不能超過左括號\n        if (closeCount < openCount) {\n            path.push_back(')');\n            backtrack(n, openCount, closeCount + 1);\n            path.pop_back();\n        }\n    }\n\npublic:\n    vector<string> generateParenthesis(int n) {\n        backtrack(n, 0, 0);\n        return result;\n    }\n};","java":"// 回溯 + 剪枝（推薦）\nclass Solution {\n    private List<String> result = new ArrayList<>();\n    private StringBuilder path = new StringBuilder();\n\n    public List<String> generateParenthesis(int n) {\n        backtrack(n, 0, 0);\n        return result;\n    }\n\n    private void backtrack(int n, int openCount, int closeCount) {\n        if (path.length() == 2 * n) {\n            result.add(path.toString());\n            return;\n        }\n\n        // 規則 1：左括號還沒用完\n        if (openCount < n) {\n            path.append('(');\n            backtrack(n, openCount + 1, closeCount);\n            path.deleteCharAt(path.length() - 1);\n        }\n\n        // 規則 2：右括號不能超過左括號\n        if (closeCount < openCount) {\n            path.append(')');\n            backtrack(n, openCount, closeCount + 1);\n            path.deleteCharAt(path.length() - 1);\n        }\n    }\n}","typescript":"// 回溯：左括號數 < n 可放左括號，右括號數 < 左括號數可放右括號\n// 時間複雜度: O(4^n / √n)，空間複雜度: O(n)\nfunction generateParenthesis(n: number): string[] {\n    const result: string[] = [];\n    const backtrack = (path: string, open: number, close: number): void => {\n        if (path.length === 2 * n) {\n            result.push(path);\n            return;\n        }\n        if (open < n) backtrack(path + '(', open + 1, close);\n        if (close < open) backtrack(path + ')', open, close + 1);\n    };\n    backtrack('', 0, 0);\n    return result;\n}\n","c":"// 回溯：左括號數 < n 可放左括號，右括號數 < 左括號數可放右括號\n// 時間複雜度: O(4^n / √n)，空間複雜度: O(n)\nstatic char** result;\nstatic int count, cap;\nstatic char path[17];                         // n ≤ 8\n\nstatic void backtrack(int n, int len, int open, int close) {\n    if (len == 2 * n) {\n        if (count == cap) {\n            cap *= 2;\n            result = realloc(result, sizeof(char*) * cap);\n        }\n        path[len] = '\\0';\n        result[count++] = strdup(path);\n        return;\n    }\n    if (open < n) {\n        path[len] = '(';\n        backtrack(n, len + 1, open + 1, close);\n    }\n    if (close < open) {\n        path[len] = ')';\n        backtrack(n, len + 1, open, close + 1);\n    }\n}\n\nchar** generateParenthesis(int n, int* returnSize) {\n    cap = 16;\n    count = 0;\n    result = malloc(sizeof(char*) * cap);\n    backtrack(n, 0, 0, 0);\n    *returnSize = count;\n    return result;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0 = lcc_int(&lc_c->a[0]);\n        int lc_rs = 0;\n        lc_t0 = lc_now();\n        char** lc_r = generateParenthesis(a0, &lc_rs);\n        lc_ms = lc_now() - lc_t0;\n        lbc_sarr(&lc_o, lc_r, lc_rs);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0 = lcx::from<int>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->generateParenthesis(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}