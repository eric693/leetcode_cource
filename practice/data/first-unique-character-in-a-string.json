rgs":["fdgbfcbaacfbcfafggdb"],"out":-1},{"args":[""],"out":20000}],"ref":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nfunction firstUniqChar(s) {\n    const count = new Array(26).fill(0);\n    for (let i = 0; i < s.length; i++)\n        count[s.charCodeAt(i) - 97]++;\n    for (let i = 0; i < s.length; i++) {\n        if (count[s.charCodeAt(i) - 97] === 1)\n            return i;\n    }\n    return -1;\n}\n","solutions":{"python":"class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        count = [0] * 26\n        for ch in s:\n            count[ord(ch) - ord('a')] += 1\n        for i, ch in enumerate(s):\n            if count[ord(ch) - ord('a')] == 1:\n                return i\n        return -1","cpp":"class Solution {\npublic:\n    int firstUniqChar(string s) {\n        vector<int> count(26, 0);\n        for (char ch : s) count[ch - 'a']++;\n        for (int i = 0; i < (int)s.size(); i++) {\n            if (count[s[i] - 'a'] == 1) return i;\n        }\n        return -1;\n    }\n};","java":"class Solution {\n    public int firstUniqChar(String s) {\n        int[] count = new int[26];\n        for (int i = 0; i < s.length(); i++) {\n            count[s.charAt(i) - 'a']++;\n        }\n        for (int i = 0; i < s.length(); i++) {\n            if (count[s.charAt(i) - 'a'] == 1) return i;\n        }\n        return -1;\n    }\n}","typescript":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nfunction firstUniqChar(s: string): number {\n    const count = new Array(26).fill(0);\n    for (let i = 0; i < s.length; i++) count[s.charCodeAt(i) - 97]++;\n    for (let i = 0; i < s.length; i++) {\n        if (count[s.charCodeAt(i) - 97] === 1) return i;\n    }\n    return -1;\n}\n","c":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nint firstUniqChar(char* s) {\n    int count[26] = {0};\n    for (int i = 0; s[i]; i++) count[s[i] - 'a']++;\n    for (int i = 0; s[i]; i++) {\n        if (count[s[i] - 'a'] == 1) return i;\n    }\n    return -1;\n}\n"}}