{"slug":"first-unique-character-in-a-string","id":387,"title":"First Unique Character in a String","difficulty":"Easy","tags":[],"fn":"firstUniqChar","params":[["s","string"]],"types":["string"],"ret":"int","cmp":"exact","desc":"<p>給定一個字串 <code>s</code>，找出其中第一個不重複的字元，並返回它的索引。如果不存在，則返回 <code>-1</code>。</p>\n<p>字串只包含小寫英文字母。</p>","constraints":["1 ≤ s.length ≤ 10⁵","s 只包含小寫英文字母"],"starter":{"python":"class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        ","typescript":"function firstUniqChar(s: string): number {\n    \n};","javascript":"/**\n * @param {string} s\n * @return {number}\n */\nvar firstUniqChar = function(s) {\n    \n};","c":"int firstUniqChar(char* s) {\n    \n}","cpp":"class Solution {\npublic:\n    int firstUniqChar(string s) {\n        \n    }\n};"},"examples":[{"args":["leetcode"],"out":0},{"args":["loveleetcode"],"out":2},{"args":["aabb"],"out":-1}],"tests":[{"args":["z"],"out":0},{"args":["zz"],"out":-1},{"args":["eddecegababcfbfeabccgaggcacfgced"],"out":-1},{"args":["cbaefegcfbebgcaedfgabggcdaggeg"],"out":-1},{"args":["ddeeggccggbfedcbdb"],"out":11},{"args":["dafedgecgafeabacgdfbcbedebdfacgfggefgcdggcecfbfa"],"out":-1},{"args":["cagfdeebfgfdbaagdfbccfbfgcceeacbfegbaedefafafdcecd"],"out":-1},{"args":["eacef"],"out":1},{"args":["dabgaccfaegagd"],"out":2},{"args":["ecdabefdecbgbcegbegfdfcefbcfbgbbabgec"],"out":-1},{"args":["bfcdedafdbebbccbbaaceadffbcdadbafbfdggcaadfacgcgadage"],"out":-1},{"args":["efeddbcccbffaeecaeedabafeeefebegacbegegcdafeegefggccfg"],"out":-1},{"args":["cabcbedgaedcbdbcgddeecb"],"out":-1},{"args":["cgabdgaabddfabdadebdcffggag"],"out":17},{"args":["ffbecee"],"out":2},{"args":["edacedegabbaefdeeafef"],"out":3},{"args":["dcaafeagba"],"out":0},{"args":["c"],"out":0},{"args":["edgffcdbaedeaacfgefebccgedddbfd"],"out":-1},{"args":["abdaggaaecdbcebfagfgbdgefcgbgacabbffceaccefgbdadfeef"],"out":-1},{"args":["cfdcfddccdcafeefffbedggfgffd"],"out":11},{"args":["cgabdegegcage"],"out":3},{"args":["gdfagbaeccfgdfbgfagcfcefbefgbfdadaegbgcdcecdccfcbfcfg"],"out":-1},{"args":["aaegfgddebegbgebbcbgbefdbabagfbbfbce"],"out":-1},{"args":["ecdegcddecefebbfa"],"out":4},{"args":["fdgbfcbaacfbcfafggdb"],"out":-1},{"args":[""],"out":20000}],"ref":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nfunction firstUniqChar(s) {\n    const count = new Array(26).fill(0);\n    for (let i = 0; i < s.length; i++)\n        count[s.charCodeAt(i) - 97]++;\n    for (let i = 0; i < s.length; i++) {\n        if (count[s.charCodeAt(i) - 97] === 1)\n            return i;\n    }\n    return -1;\n}\n","solutions":{"python":"class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        count = [0] * 26\n        for ch in s:\n            count[ord(ch) - ord('a')] += 1\n        for i, ch in enumerate(s):\n            if count[ord(ch) - ord('a')] == 1:\n                return i\n        return -1","cpp":"class Solution {\npublic:\n    int firstUniqChar(string s) {\n        vector<int> count(26, 0);\n        for (char ch : s) count[ch - 'a']++;\n        for (int i = 0; i < (int)s.size(); i++) {\n            if (count[s[i] - 'a'] == 1) return i;\n        }\n        return -1;\n    }\n};","java":"class Solution {\n    public int firstUniqChar(String s) {\n        int[] count = new int[26];\n        for (int i = 0; i < s.length(); i++) {\n            count[s.charAt(i) - 'a']++;\n        }\n        for (int i = 0; i < s.length(); i++) {\n            if (count[s.charAt(i) - 'a'] == 1) return i;\n        }\n        return -1;\n    }\n}","typescript":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nfunction firstUniqChar(s: string): number {\n    const count = new Array(26).fill(0);\n    for (let i = 0; i < s.length; i++) count[s.charCodeAt(i) - 97]++;\n    for (let i = 0; i < s.length; i++) {\n        if (count[s.charCodeAt(i) - 97] === 1) return i;\n    }\n    return -1;\n}\n","c":"// 計數陣列：第一輪統計次數，第二輪找第一個次數為 1 的字元\n// 時間複雜度: O(n)，空間複雜度: O(1)（固定 26 格）\nint firstUniqChar(char* s) {\n    int count[26] = {0};\n    for (int i = 0; s[i]; i++) count[s[i] - 'a']++;\n    for (int i = 0; s[i]; i++) {\n        if (count[s[i] - 'a'] == 1) return i;\n    }\n    return -1;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        char *a0 = lcc_str(&lc_c->a[0]);\n        lc_t0 = lc_now();\n        int lc_r = firstUniqChar(a0);\n        lc_ms = lc_now() - lc_t0;\n        lb_ll(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        string a0 = lcx::from<string>(&lc_c->a[0]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->firstUniqChar(a0);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}