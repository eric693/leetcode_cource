0) {\n        const v = matrix[row][col];\n        if (v === target)\n            return true;\n        if (v > target)\n            col--;\n        else\n            row++;\n    }\n    return false;\n}\n","solutions":{"python":"class Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        \"\"\"\n        方法一：從右上角開始搜尋（推薦）\n        時間複雜度: O(m + n)\n        空間複雜度: O(1)\n        \"\"\"\n        if not matrix or not matrix[0]:\n            return False\n        \n        m, n = len(matrix), len(matrix[0])\n        row, col = 0, n - 1  # 從右上角開始\n        \n        while row < m and col >= 0:\n            current = matrix[row][col]\n            \n            if current == target:\n                return True\n            elif current > target:\n                col -= 1  # 往左移動\n            else:\n                row += 1  # 往下移動\n        \n        return False\n    \n    def searchMatrix_leftBottom(self, matrix: List[List[int]], target: int) -> bool:\n        \"\"\"\n        方法二：從左下角開始搜尋\n        時間複雜度: O(m + n)\n        空間複雜度: O(1)\n        \"\"\"\n        if not matrix or not matrix[0]:\n            return False\n        \n        m, n = len(matrix), len(matrix[0])\n        row, col = m - 1, 0  # 從左下角開始\n        \n        while row >= 0 and col < n:\n            current = matrix[row][col]\n            \n            if current == target:\n                return True\n            elif current > target:\n                row -= 1  # 往上移動\n            else:\n                col += 1  # 往右移動\n        \n        return False\n    \n    def searchMatrix_binarySearch(self, matrix: List[List[int]], target: int) -> bool:\n        \"\"\"\n        方法三：對每一行進行二分搜尋\n        時間複雜度: O(m log n)\n        空間複雜度: O(1)\n        \"\"\"\n        if not matrix or not matrix[0]:\n            return False\n        \n        for row in matrix:\n            # 檢查 target 是否可能在這一行\n            if row[0] <= target <= row[-1]:\n                # 二分搜尋\n                left, right = 0, len(row) - 1\n                while left <= right:\n                    mid = (left + right) // 2\n                    if row[mid] == target:\n                        return True\n                    elif row[mid] < target:\n                        left = mid + 1\n                    else:\n                        right = mid - 1\n        \n        return False","cpp":"#include <vector>\nusing namespace std;\n\nclass Solution {\npublic:\n    /**\n     * 方法一：從右上角開始搜尋（推薦）\n     * 時間複雜度: O(m + n)\n     * 空間複雜度: O(1)\n     */\n    bool searchMatrix(vector<vector<int>>& matrix, int target) {\n        if (matrix.empty() || matrix[0].empty()) {\n            return false;\n        }\n        \n        int m = matrix.size(), n = matrix[0].size();\n        int row = 0, col = n - 1;  // 從右上角開始\n        \n        while (row < m && col >= 0) {\n            int current = matrix[row][col];\n            \n            if (current == target) {\n                return true;\n            } else if (current > target) {\n                col--;  // 往左移動\n            } else {\n                row++;  // 往下移動\n            }\n        }\n        \n        return false;\n    }\n    \n    /**\n     * 方法二：從左下角開始搜尋\n     * 時間複雜度: O(m + n)\n     * 空間複雜度: O(1)\n     */\n    bool searchMatrix_leftBottom(vector<vector<int>>& matrix, int target) {\n        if (matrix.empty() || matrix[0].empty()) {\n            return false;\n        }\n        \n        int m = matrix.size(), n = matrix[0].size();\n        int row = m - 1, col = 0;  // 從左下角開始\n        \n        while (row >= 0 && col < n) {\n            int current = matrix[row][col];\n            \n            if (current == target) {\n                return true;\n            } else if (current > target) {\n                row--;  // 往上移動\n            } else {\n                col++;  // 往右移動\n            }\n        }\n        \n        return false;\n    }\n};","java":"class Solution {\n    /**\n     * 方法一：從右上角開始搜尋（推薦）\n     * 時間複雜度: O(m + n)\n     * 空間複雜度: O(1)\n     */\n    public boolean searchMatrix(int[][] matrix, int target) {\n        if (matrix == null || matrix.length == 0 || matrix[0].length == 0) {\n            return false;\n        }\n        \n        int m = matrix.length, n = matrix[0].length;\n        int row = 0, col = n - 1;  // 從右上角開始\n        \n        while (row < m && col >= 0) {\n            int current = matrix[row][col];\n            \n            if (current == target) {\n                return true;\n            } else if (current > target) {\n                col--;  // 往左移動\n            } else {\n                row++;  // 往下移動\n            }\n        }\n        \n        return false;\n    }\n    \n    /**\n     * 方法二：從左下角開始搜尋\n     * 時間複雜度: O(m + n)\n     * 空間複雜度: O(1)\n     */\n    public boolean searchMatrix_leftBottom(int[][] matrix, int target) {\n        if (matrix == null || matrix.length == 0 || matrix[0].length == 0) {\n            return false;\n        }\n        \n        int m = matrix.length, n = matrix[0].length;\n        int row = m - 1, col = 0;  // 從左下角開始\n        \n        while (row >= 0 && col < n) {\n            int current = matrix[row][col];\n            \n            if (current == target) {\n                return true;\n            } else if (current > target) {\n                row--;  // 往上移動\n            } else {\n                col++;  // 往右移動\n            }\n        }\n        \n        return false;\n    }\n}","typescript":"// 從右上角出發：比目標大就往左，比目標小就往下\n// 時間複雜度: O(m + n)，空間複雜度: O(1)\nfunction searchMatrix(matrix: number[][], target: number): boolean {\n    let row = 0, col = matrix[0].length - 1;\n    while (row < matrix.length && col >= 0) {\n        const v = matrix[row][col];\n        if (v === target) return true;\n        if (v > target) col--;\n        else row++;\n    }\n    return false;\n}\n","c":"// 從右上角出發：比目標大就往左，比目標小就往下\n// 時間複雜度: O(m + n)，空間複雜度: O(1)\nbool searchMatrix(int** matrix, int matrixSize, int* matrixColSize, int target) {\n    int row = 0, col = matrixColSize[0] - 1;\n    while (row < matrixSize && col >= 0) {\n        int v = matrix[row][col];\n        if (v == target) return true;\n        if (v > target) col--;\n        else row++;\n    }\n    return false;\n}\n"}}