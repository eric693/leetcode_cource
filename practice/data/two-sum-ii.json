-712,-709,-700,-695,-692,-669,-648,-644,-608,-605,-601,-589,-544,-443,-439,-426,-380,-367,-357,-322,-316,-273,-266,-247,-233,-228,-210,-191,-172,-169,-155,-155,-149,-138,-133,-126,-106,-81,-71,-71,-70,-61,-60,-38,13,34,37,39,44,58,63,78,90,94,111,130,143,183,190,195,206,219,264,266,331,334,345,386,387,394,410,411,421,440,454,457,460,474,474,503,509,517,522,540,556,603,613,655,662,723,748,754,757,769,784,798,862,885,885,889,896,898,900,954,955,970,975],1052],"out":[81,119]},{"args":[[-991,-985,-981,-967,-962,-954,-953,-949,-944,-943,-928,-926,-901,-900,-898,-897,-883,-879,-875,-847,-838,-833,-832,-813,-804,-803,-750,-741,-725,-718,-708,-683,-673,-672,-670,-665,-657,-646,-644,-643,-635,-614,-613,-605,-598,-596,-594,-562,-545,-533,-519,-511,-503,-495,-488,-485,-467,-462,-445,-434,-422,-420,-404,-378,-375,-372,-370,-356,-355,-355,-345,-344,-334,-331,-330,-287,-284,-275,-267,-266,-236,-217,-214,-213,-203,-202,-192,-183,-162,-148,-134,-123,-122,-122,-112,-102,-97,-86,-85,-48,-43,-23,-21,-19,-13,-8,-5,5,30,32,35,47,48,66,67,78,82,101,104,104,107,123,129,146,155,166,176,180,186,195,207,214,215,233,235,235,248,260,264,271,283,294,297,299,299,305,314,314,319,326,335,356,358,362,364,369,380,389,399,401,405,410,415,416,425,455,471,488,489,498,499,507,522,523,534,534,546,553,557,561,563,565,594,644,645,655,657,677,679,716,722,727,730,734,738,763,767,770,774,802,803,820,837,848,850,868,871,889,908,908,908,922,926,932,940,950,955,967,986],1687],"out":[203,205]}],"ref":"// 有序陣列 + 雙指標：和太小左指標右移，太大右指標左移\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction twoSum(numbers, target) {\n    let left = 0, right = numbers.length - 1;\n    while (left < right) {\n        const sum = numbers[left] + numbers[right];\n        if (sum === target)\n            return [left + 1, right + 1]; // 題目要求 1-indexed\n        if (sum < target)\n            left++;\n        else\n            right--;\n    }\n    return [];\n}\n","solutions":{"python":"class Solution:\n    def twoSum(self, numbers: List[int], target: int) -> List[int]:\n        \"\"\"\n        方法：雙指標（推薦）\n        時間複雜度: O(n)\n        空間複雜度: O(1)\n        \"\"\"\n        left = 0\n        right = len(numbers) - 1\n        \n        while left < right:\n            current_sum = numbers[left] + numbers[right]\n            \n            if current_sum == target:\n                # 找到答案，注意索引從 1 開始\n                return [left + 1, right + 1]\n            elif current_sum < target:\n                # 和太小，需要更大的數\n                left += 1\n            else:\n                # 和太大，需要更小的數\n                right -= 1\n        \n        # 題目保證有解，不會到這裡\n        return []\n    \n    def twoSum_hashmap(self, numbers: List[int], target: int) -> List[int]:\n        \"\"\"\n        方法二：哈希表（不推薦，空間複雜度較高）\n        時間複雜度: O(n)\n        空間複雜度: O(n)\n        \"\"\"\n        seen = {}\n        \n        for i, num in enumerate(numbers):\n            complement = target - num\n            if complement in seen:\n                return [seen[complement] + 1, i + 1]\n            seen[num] = i\n        \n        return []","cpp":"#include <vector>\n\nclass Solution {\npublic:\n    /**\n     * 方法：雙指標（推薦）\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(1)\n     */\n    std::vector<int> twoSum(std::vector<int>& numbers, int target) {\n        int left = 0;\n        int right = numbers.size() - 1;\n        \n        while (left < right) {\n            int currentSum = numbers[left] + numbers[right];\n            \n            if (currentSum == target) {\n                // 找到答案，注意索引從 1 開始\n                return {left + 1, right + 1};\n            } else if (currentSum < target) {\n                // 和太小，需要更大的數\n                left++;\n            } else {\n                // 和太大，需要更小的數\n                right--;\n            }\n        }\n        \n        // 題目保證有解，不會到這裡\n        return {};\n    }\n};","java":"class Solution {\n    /**\n     * 方法：雙指標（推薦）\n     * 時間複雜度: O(n)\n     * 空間複雜度: O(1)\n     */\n    public int[] twoSum(int[] numbers, int target) {\n        int left = 0;\n        int right = numbers.length - 1;\n        \n        while (left < right) {\n            int currentSum = numbers[left] + numbers[right];\n            \n            if (currentSum == target) {\n                // 找到答案，注意索引從 1 開始\n                return new int[]{left + 1, right + 1};\n            } else if (currentSum < target) {\n                // 和太小，需要更大的數\n                left++;\n            } else {\n                // 和太大，需要更小的數\n                right--;\n            }\n        }\n        \n        // 題目保證有解，不會到這裡\n        return new int[]{};\n    }\n}","typescript":"// 有序陣列 + 雙指標：和太小左指標右移，太大右指標左移\n// 時間複雜度: O(n)，空間複雜度: O(1)\nfunction twoSum(numbers: number[], target: number): number[] {\n    let left = 0, right = numbers.length - 1;\n    while (left < right) {\n        const sum = numbers[left] + numbers[right];\n        if (sum === target) return [left + 1, right + 1];   // 題目要求 1-indexed\n        if (sum < target) left++;\n        else right--;\n    }\n    return [];\n}\n","c":"// 有序陣列 + 雙指標：和太小左指標右移，太大右指標左移\n// 時間複雜度: O(n)，空間複雜度: O(1)\nint* twoSum(int* numbers, int numbersSize, int target, int* returnSize) {\n    int* ans = malloc(sizeof(int) * 2);\n    *returnSize = 2;\n    int left = 0, right = numbersSize - 1;\n    while (left < right) {\n        int sum = numbers[left] + numbers[right];\n        if (sum == target) {\n            ans[0] = left + 1;                             // 題目要求 1-indexed\n            ans[1] = right + 1;\n            return ans;\n        }\n        if (sum < target) left++;\n        else right--;\n    }\n    *returnSize = 0;\n    return ans;\n}\n"},"cDriver":"int main(void) {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        int a0n; int *a0 = lcc_iarr(&lc_c->a[0], &a0n);\n        int a1 = lcc_int(&lc_c->a[1]);\n        int lc_rs = 0;\n        lc_t0 = lc_now();\n        int* lc_r = twoSum(a0, a0n, a1, &lc_rs);\n        lc_ms = lc_now() - lc_t0;\n        lbc_iarr(&lc_o, lc_r, lc_rs);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}","cppDriver":"int main() {\n    char *lc_buf = lc_read_all(); const char *lc_p = lc_buf;\n    int lc_n = (int)strtol(lc_p, (char **)&lc_p, 10);\n    for (int lc_i = 0; lc_i < lc_n; lc_i++) {\n        LJ *lc_c = lj_parse(&lc_p);\n        lc_start(lc_i);\n        LB lc_o = {0};\n        double lc_t0, lc_ms;\n        vector<int> a0 = lcx::from<vector<int>>(&lc_c->a[0]);\n        int a1 = lcx::from<int>(&lc_c->a[1]);\n        Solution *lc_sol = new Solution();\n        lc_t0 = lc_now();\n        auto lc_r = lc_sol->twoSum(a0, a1);\n        lc_ms = lc_now() - lc_t0;\n        lcx::put(&lc_o, lc_r);\n        lc_result(lc_i, lc_ms, &lc_o);\n    }\n    return 0;\n}"}